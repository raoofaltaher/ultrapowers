# Ensure shell scripts always have LF line endings
*.sh text eol=lf
hooks/session-start text eol=lf
hooks/team-memory-nudge text eol=lf
hooks/team-memory-postcompact text eol=lf
hooks/qa-guardrail text eol=lf
# QA gatekeeper: psql meta-commands and the judge fixtures must stay LF
*.sql text eol=lf
tests/qa-gatekeeper/fixtures/judge/*.trx text eol=lf
tests/qa-gatekeeper/fixtures/judge/*.xml text eol=lf
hooks/lib/* text eol=lf
# Skill helper scripts are often extensionless; keep them LF too
skills/*/scripts/* text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
*.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary

# Ultrapowers templates and the hook template must stay LF; the engine copies
# them byte-for-byte into projects, and the pre-commit template runs under sh
*.tmpl text eol=lf
templates/.githooks/* text eol=lf
templates/.mcp.json text eol=lf
templates/CHANGES.json text eol=lf
