#!/usr/bin/env bash
# Shared helpers for hooks/team-memory-nudge and hooks/team-memory-postcompact.
# Sourced by those two scripts, never executed. hooks/session-start does not
# use this file on purpose: its tested output must stay byte-identical. The
# input reader, the JSON field reader and the platform selection below are
# copies of its versions, with the event name made a parameter.
#
# The nudge hook runs on every prompt in every repository, so these helpers
# stay in bash: no node, and no fork per directory level.

# read_hook_input: the hook's stdin JSON. Waits at most one second, so a
# harness that keeps stdin open cannot stall the prompt; empty on a terminal.
read_hook_input() {
  local input=""
  if [ ! -t 0 ]; then
    IFS= read -r -d '' -t 1 input || true
  fi
  printf '%s' "$input"
}

# json_string_field <json> <key>: the first string value of <key>, or the
# first element when the value is an array of strings (Cursor's
# workspace_roots). Returns 1 when the key is missing or the value uses an
# escape other than \" \\ \/. The value is capped at 4096 characters.
json_string_field() {
  local json="$1" key="$2" rest value="" ch
  case "$json" in
    *"\"$key\""*) ;;
    *) return 1 ;;
  esac
  rest="${json#*\"$key\"}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  [ "${rest:0:1}" = ":" ] || return 1
  rest="${rest:1}"
  rest="${rest#"${rest%%[![:space:]]*}"}"
  if [ "${rest:0:1}" = "[" ]; then
    rest="${rest:1}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
  fi
  [ "${rest:0:1}" = '"' ] || return 1
  rest="${rest:1:4096}"
  while [ -n "$rest" ]; do
    ch="${rest:0:1}"
    case "$ch" in
      '"')
        printf '%s' "$value"
        return 0
        ;;
      '\')
        case "${rest:1:1}" in
          '"' | '\' | '/') value+="${rest:1:1}" ;;
          *) return 1 ;;
        esac
        rest="${rest:2}"
        ;;
      *)
        value+="$ch"
        rest="${rest:1}"
        ;;
    esac
  done
  return 1
}

# hook_cwd <json>: the project directory the harness names ("cwd" from Claude
# Code, Copilot CLI and Muse; "workspace_roots" from Cursor), else $PWD.
hook_cwd() {
  local dir
  dir="$(json_string_field "$1" cwd || json_string_field "$1" workspace_roots || true)"
  [ -n "$dir" ] || dir="$PWD"
  printf '%s' "$dir"
}

# nudge_off: ULTRAPOWERS_NUDGE=off is a personal off switch for every
# ultrapowers nudge line, these two included.
nudge_off() {
  case "${ULTRAPOWERS_NUDGE:-}" in
    [Oo][Ff][Ff]) return 0 ;;
  esac
  return 1
}

# find_memory_store <dir>: prints the relative path from <dir> to the nearest
# .agents/memory/ that holds a MEMORY.md at or above it (".agents/memory/",
# "../.agents/memory/", ...). Returns 1 and prints nothing when there is none
# or <dir> does not exist. Windows backslashes are accepted.
find_memory_store() {
  local start="$1" dir parent prefix=""
  start="${start//\\//}"
  dir="$(cd "$start" 2>/dev/null && pwd -P)" || return 1
  while :; do
    if [ -f "${dir%/}/.agents/memory/MEMORY.md" ]; then
      printf '%s.agents/memory/' "$prefix"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    parent="${dir%/*}"
    [ -n "$parent" ] || parent="/"
    dir="$parent"
    prefix="../${prefix}"
  done
}

# escape_for_json <s>: same passes as hooks/session-start.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# emit_context <hookEventName> <text>: print the one JSON shape the current
# harness consumes. Same branch order and env contract as hooks/session-start:
# Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT); Claude Code
# sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI or MUSE_PLUGIN_ROOT; Muse sets
# MUSE_PLUGIN_ROOT; Copilot CLI and unknown platforms get the SDK shape.
# emit_json mirrors session-start: printf piped through cat (which absorbs EPIPE on
# Windows + Git Bash) when cat is on PATH, printf alone when PATH is broken.
emit_json() {
  # shellcheck disable=SC2059 # every caller passes a literal format string
  if command -v cat >/dev/null 2>&1; then
    printf "$@" | cat
  else
    printf "$@"
  fi
}

emit_context() {
  local event="$1" text="$2" escaped
  escaped="$(escape_for_json "$text")"
  if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    emit_json '{\n  "additional_context": "%s"\n}\n' "$escaped"
  elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
    emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$escaped"
  elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
    emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$escaped"
  else
    emit_json '{\n  "additionalContext": "%s"\n}\n' "$escaped"
  fi
}
