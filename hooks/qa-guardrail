#!/usr/bin/env bash
# qa-guardrail: PreToolUse guardrail for the ultrapowers QA gatekeeper (spec 3.5), the
# vulnerability hunt and the autopilot envelope (autopilot spec section 8).
#
# stdin  : the harness event JSON (tool_name, tool_input, optional cwd)
# env    : ULTRAPOWERS_RUN_DIR, set only by hooks/lib/guardrail-bridge.mjs on the hook's spawn: the
#          absolute directory the bridge found the run from (see the root scan below). Nothing
#          else sets it; the run directory never travels inside the event.
# exit 0 : allow.  exit 2 : deny; stderr carries "QA-GUARDRAIL DENY: <reason>",
#          "HUNT-GUARDRAIL DENY: <reason>" or "AUTOPILOT-GUARDRAIL DENY: <reason>".
#
# Inert unless a run guards this call. A QA run (the QA profile: read-only, writes under
# reviews/<id>/ only) or a vulnerability hunt (the hunt profile: the QA rules with the audit id in
# place of the ticket, plus the audit tools of the hunt allowed and no test suite, no worktree and no
# tracker write) is a run record, .ultrapowers/runs/<run>.json in the nearest project root
# (hooks/lib/run-records.mjs): any number are active at once, and a record guards only its own
# session (Claude Code's session_id, its subagents included) or, bound to no session, the calls made
# in its own project folder. A record above the nearest project root never counts. An autopilot stage
# is `.ultrapowers/autopilot-active` at or above the working directory (the autopilot profile: writes
# anywhere in the worktree except protected paths; no push, no merge, no tracker write; the engine does
# those between stages). A record that guards the call comes before the autopilot marker. The skills
# write the records and end them at the end of the run; every other session pays a directory walk,
# and one node start while some run of its project is active.
#
# `set -uo pipefail` and NOT `-e`: the "grep matches -> deny, else continue" pattern below
# relies on a non-matching grep returning non-zero without aborting the script.
set -uo pipefail

GUARD_PREFIX="QA-GUARDRAIL"
# Every harness blocks on exit 2 with the reason on stderr. Cursor and Copilot CLI also read a
# JSON verdict on stdout, in their own shapes; the others get no stdout at all (Gemini CLI
# allows the call when stdout holds anything but JSON).
deny() {
  marker_suffix_r
  local msg="$GUARD_PREFIX DENY: $1$REPLY"
  printf '%s\n' "$msg" >&2
  local escaped
  escaped="$(printf '%s' "$msg" | sed 's/["\\]/\\&/g')"
  if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{"permission":"deny","agent_message":"%s"}\n' "$escaped"
  elif [ -n "${COPILOT_CLI:-}" ]; then
    printf '{"permissionDecision":"deny","permissionDecisionReason":"%s"}\n' "$escaped"
  fi
  exit 2
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The run marker as a fact in every deny: where it is, whose run it is, how old it is, and who can
# end it. A marker can outlive its run; the advice to end it is addressed to the human partner and
# never to the agent (an agent told to remove its own guardrail would do it). Shell builtins only.
# Result in REPLY; empty before a run is known.
marker_suffix_r() {
  REPLY=""
  [ -n "${root:-}" ] || return 0
  local f ticket_id="${ticket:-}" age="${marker_age:-}" stage="${marker_stage:-}"
  if [ "${PROFILE:-}" = "autopilot" ]; then
    f="$root/.ultrapowers/autopilot-active"
    if [ -f "$f" ]; then
      REPLY=" (autopilot stage${stage:+ $stage}${ticket_id:+ for ticket $ticket_id}: $f${age:+, $age old}. If no stage is running, your human partner can end it with autopilot.mjs end ${ticket_id:-<ID>} ${stage:-<stage>} or remove that file.)"
    else
      REPLY=" (autopilot stage${ticket_id:+ for ticket $ticket_id}: ULTRAPOWERS_AUTOPILOT_INSIDE is set and the marker $f is gone. If no stage is running, your human partner can end it with autopilot.mjs end ${ticket_id:-<ID>} ${stage:-<stage>} or unset that variable.)"
    fi
  elif [ "${PROFILE:-}" = "hunt" ]; then
    f="${RUN_FILE:-$root/.ultrapowers/runs/}"
    REPLY=" (vulnerability hunt${ticket_id:+ $ticket_id}: $f${age:+, $age old}. The hunt ends itself when its report is written; if its run is gone, your human partner can remove that file.)"
  else
    f="${RUN_FILE:-$root/.ultrapowers/runs/}"
    REPLY=" (QA run${ticket_id:+ for ticket $ticket_id}: $f${age:+, $age old}. The run ends itself when its report is written; if its run is gone, your human partner can remove that file.)"
  fi
}

# The inert path below runs on every tool call of every session with the plugin installed,
# so everything up to the marker check uses shell builtins only: no process is started.
# Results come back in REPLY; `${x,,}` is avoided because macOS still ships bash 3.2.
UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
LOWER=abcdefghijklmnopqrstuvwxyz

# Forward slashes, collapsed; a Windows drive prefix `X:` becomes `/x`; no trailing slash.
norm_path_r() {
  local p="$1" slash='/' head letter
  p="${p//\\/$slash}"
  while [[ "$p" == *//* ]]; do p="${p//\/\//$slash}"; done
  if [[ ${#p} -gt 1 && "$p" == */ ]]; then p="${p%/}"; fi
  if [[ "$p" =~ ^([A-Za-z]):(.*)$ ]]; then
    letter="${BASH_REMATCH[1]}"
    head="${UPPER%%"$letter"*}"
    if [[ ${#head} -lt 26 ]]; then letter="${LOWER:${#head}:1}"; fi
    p="/$letter${BASH_REMATCH[2]}"
  fi
  REPLY="$p"
}
norm_path() { norm_path_r "$1"; printf '%s' "$REPLY"; }

# Lowercase in REPLY with no process (a fork costs tens of milliseconds on Windows, and the loops
# over a call's paths, patch files and URLs must not grow with their number).
lower_r() {
  local s="$1" i
  for ((i = 0; i < 26; i++)); do s="${s//${UPPER:i:1}/${LOWER:i:1}}"; done
  REPLY="$s"
}

# The run record that guards this call in the folder $1, picked by hooks/lib/run-records.mjs
# from the records there and the event's top-level session_id; with $2 = --session-only (a folder
# above the call's nearest project root), only a record bound to this very session. Sets PROFILE
# (qa, hunt or corrupt), RUN_ID, RUN_FILE and RUN_STARTED; fails when no record guards the call.
# Records exist, so a run is active: without node the call cannot be judged, and it is refused.
pick_run_r() {
  local d="$1" only="${2:-}" rr_src rr_js d_node picked rest
  command -v node >/dev/null 2>&1 || deny "node is required to read the run records of $d/.ultrapowers/runs/ and is not on PATH"
  rr_src="${BASH_SOURCE[0]}"
  rr_src="${rr_src//\\//}"
  case "$rr_src" in */*) rr_js="${rr_src%/*}/lib/run-records.mjs" ;; *) rr_js="lib/run-records.mjs" ;; esac
  d_node="$d"
  if command -v cygpath >/dev/null 2>&1; then
    rr_js="$(cygpath -m "$rr_js" 2>/dev/null || printf '%s' "$rr_js")"
    d_node="$(cygpath -m "$d" 2>/dev/null || printf '%s' "$d")"
  fi
  picked="$(printf '%s' "$event" | node "$rr_js" pick --root "$d_node" ${only:+"$only"} 2>/dev/null)" \
    || deny "the run records of $d/.ultrapowers/runs/ could not be read; every call of this project is refused while they cannot"
  [ -n "$picked" ] || return 1
  PROFILE="${picked%%$'\t'*}"; rest="${picked#*$'\t'}"
  RUN_ID="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
  rest="${rest#*$'\t'}"
  RUN_STARTED="${rest%%$'\t'*}"; RUN_FILE="${rest#*$'\t'}"
  return 0
}

# Walk up from $1 looking for a run; REPLY is the directory and PROFILE is `qa`, `hunt`, `corrupt`
# or `autopilot`. Run records count up to the nearest project root (the first folder with
# .agents/ultrapowers.json), and only the one that guards this call; above it, only a record bound
# to this call's own session (a run guards its session in a nested project or worktree too). The
# autopilot marker counts at any height, after a record of the same folder.
PROFILE=""; RUN_ID=""; RUN_FILE=""; RUN_STARTED=""
find_root_r() {
  local d="$1" past_project="" f
  REPLY=""
  [ -n "$d" ] || return 1
  while :; do
    if [ -d "$d/.ultrapowers/runs" ]; then
      for f in "$d/.ultrapowers/runs/"*.json; do
        [ -e "$f" ] || break
        if [ -z "$past_project" ]; then
          if pick_run_r "$d"; then REPLY="$d"; return 0; fi
        elif pick_run_r "$d" --session-only; then REPLY="$d"; return 0; fi
        break
      done
    fi
    if [ -f "$d/.ultrapowers/autopilot-active" ]; then
      REPLY="$d"
      PROFILE="autopilot"
      return 0
    fi
    [ -f "$d/.agents/ultrapowers.json" ] && past_project=1
    case "$d" in
      /|.|"") return 1 ;;
      # A relative path with no slash left has no parent to climb to (a hook that never returns
      # is killed at its timeout, and a killed hook lets the call through).
      */*) ;;
      *) return 1 ;;
    esac
    d="${d%/*}"
    [ -n "$d" ] || d="/"
  done
}
find_root() { find_root_r "$1" || return 1; printf '%s' "$REPLY"; }

event=""
# read -N takes the pipe in blocks; read -d '' takes it one byte per call, 2 s per MB on Windows.
# NUL bytes are dropped (the bridge ends the event with one; JSON escapes any other).
ev_chunk=""
while IFS= read -r -N 1048576 ev_chunk; do event+="$ev_chunk"; done
event+="$ev_chunk"

# --- Fast path: is a run active? The scan starts from ULTRAPOWERS_RUN_DIR when it is set, else
# from the process cwd; then the event's TOP-LEVEL cwd alone is a further start. A key nested
# under tool_input (cwd, workdir, working_directory, dir_path, ultrapowers_run_dir, ...) never
# names the root: a tool argument would then choose the run, its profile and its project config.
#
# ULTRAPOWERS_RUN_DIR is set by hooks/lib/guardrail-bridge.mjs alone, on the hook's spawn: the
# bridge runs the hook from the plugin folder (OpenCode, Pi, and through guardrail-cli.mjs Kimi,
# Antigravity, Hermes and the Gemini project hook) and passes the directory it found the run from
# out of band, never inside the event. It must be an absolute, existing directory, or every call
# is refused. Unset (Claude Code, Cursor, Muse, Codex, Copilot CLI, Droid, Qwen Code, Devin), the
# scan starts from the hook's own cwd, the session directory the harness runs it in; then the
# top-level cwd, then the top-level workspace_roots[0] (Cursor's event carries the project there and
# no cwd, and runs the hook from the plugin folder), then CURSOR_PROJECT_DIR, the last two only when
# absolute and existing. Each is set by the harness; a copy nested under tool_input never counts.
#
# No process is started for an inert session, with one exception: the top-level fields are read
# through node (hooks/lib/event-fields.mjs) only when some "cwd" or "workspace_roots" string in the
# event text leads to a marker, or when the event is past the prefilter's bound (over 256 KB or
# more than 64 candidates) and node is on PATH; then an inert event costs one node start.
root=""
root_start=""
abs_dir_r() { # $1 a path: REPLY its normalized form when absolute and an existing directory, else fail
  REPLY=""
  case "$1" in /*|[A-Za-z]:/*|[A-Za-z]:\\*) ;; *) return 1 ;; esac
  norm_path_r "$1"
  [ -d "$REPLY" ] || { REPLY=""; return 1; }
}
if [ -n "${ULTRAPOWERS_RUN_DIR+x}" ]; then
  case "$ULTRAPOWERS_RUN_DIR" in
    /*|[A-Za-z]:/*|[A-Za-z]:\\*) ;;
    *) deny "ULTRAPOWERS_RUN_DIR ($ULTRAPOWERS_RUN_DIR) is not an absolute path; the run directory cannot be verified, so every call is refused" ;;
  esac
  norm_path_r "$ULTRAPOWERS_RUN_DIR"
  scan_start="$REPLY"
  [ -d "$scan_start" ] || deny "ULTRAPOWERS_RUN_DIR ($ULTRAPOWERS_RUN_DIR) does not name an existing directory; the run directory cannot be verified, so every call is refused"
  if find_root_r "$scan_start"; then root="$REPLY"; fi
else
  norm_path_r "$PWD"
  scan_start="$REPLY"
  if find_root_r "$scan_start"; then
    root="$REPLY"
  else
    # A superset filter with builtins only: every "cwd" string and every first "workspace_roots"
    # entry in the text, the nested ones too. Only when one of them leads to a marker are the real
    # top-level fields read, and only they count.
    # Linear and bounded: the scan reads at most the first 256 KB of the event and 64 candidates,
    # and each match advances by an offset (a ${rest#*match} strip is quadratic in bash, and a hook
    # killed at its timeout lets the call through on some harnesses). Past either bound the filter
    # cannot rule a run out, so the top-level fields are read through node as on a hit.
    scan_cap=262144
    rest="${event:0:$scan_cap}"
    over_cap=""
    [ "${#event}" -gt "$scan_cap" ] && over_cap=1
    cwd_re='"(cwd|workspace_roots)"[[:space:]]*:[[:space:]]*\[?[[:space:]]*"([^"]*)"'
    hit=""
    n_cand=0
    while [[ "$rest" =~ $cwd_re ]]; do
      n_cand=$((n_cand + 1))
      if [ "$n_cand" -gt 64 ]; then over_cap=1; break; fi
      m="${BASH_REMATCH[0]}"
      candidate="${BASH_REMATCH[2]}"
      pre="${rest%%"$m"*}"
      rest="${rest:$((${#pre} + ${#m}))}"
      [ -n "$candidate" ] || continue
      norm_path_r "$candidate"
      if find_root_r "$REPLY"; then hit=1; break; fi
    done
    PROFILE=""; RUN_ID=""; RUN_FILE=""; RUN_STARTED=""
    # Past the bound with no node the event cannot be read: an inert session must not depend on
    # node, so the call goes on to the CURSOR_PROJECT_DIR start and, failing that, is allowed.
    if [ -z "$hit" ] && [ -n "$over_cap" ] && command -v node >/dev/null 2>&1; then hit=1; fi
    if [ -n "$hit" ]; then
      command -v node >/dev/null 2>&1 || deny "node is required to read the event of a call that names a run directory, and is not on PATH"
      ef_src="${BASH_SOURCE[0]}"
      ef_slash='/'
      ef_src="${ef_src//\\/$ef_slash}"
      case "$ef_src" in */*) ef_js="${ef_src%/*}/lib/event-fields.mjs" ;; *) ef_js="lib/event-fields.mjs" ;; esac
      if command -v cygpath >/dev/null 2>&1; then ef_js="$(cygpath -m "$ef_js" 2>/dev/null || printf '%s' "$ef_js")"; fi
      top_fields="$(printf '%s' "$event" | node "$ef_js" cwd 'workspace_roots[0]')" || deny "the tool event could not be parsed for its top-level cwd; an uninspectable call is refused"
      case "$top_fields" in
        *$'\n'*) top_cwd="${top_fields%%$'\n'*}"; top_ws="${top_fields#*$'\n'}" ;;
        *) top_cwd="$top_fields"; top_ws="" ;;
      esac
      if [ -n "$top_cwd" ]; then
        norm_path_r "$top_cwd"
        if find_root_r "$REPLY"; then root="$REPLY"; fi
      fi
      if [ -z "$root" ] && abs_dir_r "$top_ws" && find_root_r "$REPLY"; then
        root="$REPLY"; abs_dir_r "$top_ws"; root_start="$REPLY"
      fi
    fi
  fi
  if [ -z "$root" ] && [ -n "${CURSOR_PROJECT_DIR:-}" ] && abs_dir_r "$CURSOR_PROJECT_DIR" && find_root_r "$REPLY"; then
    root="$REPLY"; abs_dir_r "$CURSOR_PROJECT_DIR"; root_start="$REPLY"
  fi
fi
# A headless watcher stage carries ULTRAPOWERS_AUTOPILOT_INSIDE=1 in its environment: the
# envelope then holds even when the marker file is gone (the root is the project that holds
# .agents/ultrapowers.json above the scan start: ULTRAPOWERS_RUN_DIR or the hook's cwd, never a
# key of the event; no project, no verifiable call).
if [ -z "$root" ] && [ "${ULTRAPOWERS_AUTOPILOT_INSIDE:-}" = "1" ]; then
  d="$scan_start"
  while :; do
    if [ -f "$d/.agents/ultrapowers.json" ]; then root="$d"; PROFILE="autopilot"; break; fi
    case "$d" in /|.|"") break ;; */*) ;; *) break ;; esac
    d="${d%/*}"; [ -n "$d" ] || d="/"
  done
  [ -n "$root" ] || deny "an autopilot stage is running (ULTRAPOWERS_AUTOPILOT_INSIDE) outside any ultrapowers project; the call cannot be verified"
fi
[ -n "$root" ] || exit 0
[ "$PROFILE" = "corrupt" ] && deny "a run record cannot be read ($RUN_FILE); every call of this project is refused while it exists. Your human partner removes that file"
[ "$PROFILE" = "autopilot" ] && GUARD_PREFIX="AUTOPILOT-GUARDRAIL"
[ "$PROFILE" = "hunt" ] && GUARD_PREFIX="HUNT-GUARDRAIL"
run_kind="a QA run"
[ "$PROFILE" = "autopilot" ] && run_kind="an autopilot stage"
[ "$PROFILE" = "hunt" ] && run_kind="a vulnerability hunt"

# --- Active. From here on an uninspectable call is denied, never waved through.
command -v node >/dev/null 2>&1 || deny "node is required to inspect tool calls during $run_kind and is not on PATH"
# The rules below are grep, sed and tr pipelines: a missing tool would make every rule
# "not match" and allow the call.
for tool in grep sed tr; do
  command -v "$tool" >/dev/null 2>&1 || deny "$tool is required to inspect tool calls during $run_kind and is not on PATH"
done

# Node on Windows reads `/c/x` as `C:\c\x` unless Git Bash converts the argument, and a
# harness may run hooks with that conversion off. Hand node a mixed path (`C:/x`) instead.
root_node="$root"
if command -v cygpath >/dev/null 2>&1; then
  root_node="$(cygpath -m "$root" 2>/dev/null)" || root_node="$root"
fi
# The project folder the harness named (workspace_roots[0] or CURSOR_PROJECT_DIR) when the root came
# from it: relative file-tool paths resolve there, as the shell's do, when the event has no cwd.
root_start_node="$root_start"
if [ -n "$root_start" ] && command -v cygpath >/dev/null 2>&1; then
  root_start_node="$(cygpath -m "$root_start" 2>/dev/null)" || root_start_node="$root_start"
fi

# The hook's own folder: the node block and the write analyzer load hooks/lib/ from it.
# cmd.exe hands bash this script as S:\...\hooks\qa-guardrail, so normalize the slashes first.
hook_src="${BASH_SOURCE[0]}"
slash='/'
hook_src="${hook_src//\\/$slash}"
case "$hook_src" in */*) hook_dir="${hook_src%/*}" ;; *) hook_dir="." ;; esac
hook_dir_node="$hook_dir"
if command -v cygpath >/dev/null 2>&1; then hook_dir_node="$(cygpath -m "$hook_dir" 2>/dev/null || printf '%s' "$hook_dir")"; fi

parse_status=""; tool=""; cmd=""; wpath=""; url=""; event_cwd=""; allowed=""; forbidden=""; ticket=""; keypaths=""; tracker_hosts=""; ignore_case="0"
wpath_real=""; wpath_rel=""; keypaths_real=""; patch_recs=""; role_vars=""; ro_role=""; marker_age=""; marker_stage=""; known_issues=""; workdir_state=""; workdir_real=""; keyglob=""; mcp_servers=""
{
  IFS= read -r -d '' parse_status || true
  IFS= read -r -d '' tool || true
  IFS= read -r -d '' cmd || true
  IFS= read -r -d '' wpath || true
  IFS= read -r -d '' url || true
  IFS= read -r -d '' event_cwd || true
  IFS= read -r -d '' allowed || true
  IFS= read -r -d '' forbidden || true
  IFS= read -r -d '' ticket || true
  IFS= read -r -d '' keypaths || true
  IFS= read -r -d '' tracker_hosts || true
  IFS= read -r -d '' ignore_case || true
  IFS= read -r -d '' wpath_real || true
  IFS= read -r -d '' wpath_rel || true
  IFS= read -r -d '' keypaths_real || true
  IFS= read -r -d '' patch_recs || true
  IFS= read -r -d '' role_vars || true
  IFS= read -r -d '' ro_role || true
  IFS= read -r -d '' marker_age || true
  IFS= read -r -d '' marker_stage || true
  IFS= read -r -d '' known_issues || true
  IFS= read -r -d '' workdir_state || true
  IFS= read -r -d '' workdir_real || true
  IFS= read -r -d '' keyglob || true
  IFS= read -r -d '' mcp_servers || true
} < <(printf '%s' "$event" | node -e '
const fs = require("node:fs");
const path = require("node:path");
let ev;
try { ev = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) { ev = null; }
if (!ev || typeof ev !== "object") {
  process.stdout.write(["unparseable", "", "", "", "", "", "", "", ""].join("\0") + "\0");
  process.exit(0);
}
const root = process.argv[1];
const str = (v) => (typeof v === "string" ? v : "");
// The harnesses spell the event differently: tool_name / toolName, tool_input / toolArgs / input
// (Copilot CLI sends toolArgs as a JSON string). Normalize the documented shapes, then refuse
// what is left: an event with no readable tool name or no object as input is not "nothing to
// check", it is a call that cannot be judged.
const shapeless = () => {
  process.stdout.write(["shapeless", "", "", "", "", "", "", "", ""].join("\0") + "\0");
  process.exit(0);
};
if (Array.isArray(ev)) shapeless();
const toolName = typeof ev.tool_name === "string" && ev.tool_name ? ev.tool_name : ev.toolName;
if (typeof toolName !== "string" || !toolName) shapeless();
let toolInput = [ev.tool_input, ev.toolArgs, ev.input].find((v) => v !== undefined && v !== null);
if (typeof toolInput === "string") { try { toolInput = JSON.parse(toolInput); } catch (e) { shapeless(); } }
if (!toolInput || typeof toolInput !== "object" || Array.isArray(toolInput)) shapeless();
const inp = { ...toolInput };
// A shell command given as an argv array runs as the words joined.
if (Array.isArray(inp.command)) {
  if (!inp.command.every((w) => typeof w === "string")) shapeless();
  inp.command = inp.command.join(" ");
}
let qa = {};
let sources = [];
try {
  // A byte order mark is valid for the preflight, so it is valid here; any other read or
  // parse failure is reported, never taken as an empty config with no host lists.
  const raw = fs.readFileSync(path.join(root, ".agents", "ultrapowers.json"), "utf8").replace(/^\uFEFF/, "");
  const cfg = JSON.parse(raw) || {};
  qa = cfg.qa || {};
  sources = cfg.tickets && Array.isArray(cfg.tickets.sources) ? cfg.tickets.sources : [];
} catch (e) {
  process.stdout.write(["badconfig:" + String(e.message).split("\n")[0], "", "", "", "", "", "", "", ""].join("\0") + "\0");
  process.exit(0);
}
const hosts = qa.hosts && typeof qa.hosts === "object" ? qa.hosts : {};
const norm = (list) => (Array.isArray(list) ? list : []).map((h) => str(h).trim().toLowerCase()).filter(Boolean);
const allowed = norm(hosts.allowed);
const urls = qa.urls && typeof qa.urls === "object" ? qa.urls : {};
for (const value of Object.values(urls)) {
  try { if (str(value)) allowed.push(new URL(value).hostname.toLowerCase()); } catch (e) { /* not a URL */ }
}
// The hosts of the ticket trackers (an Odoo source names its server by URL): a stage never
// calls the tracker from the shell, whatever the egress allow-list says.
// The variables that hold the logins of the QA roles: the only names a QA run may read with printenv.
const roleVars = [];
for (const role of Array.isArray(qa.roles) ? qa.roles : []) {
  if (!role || typeof role !== "object") continue;
  for (const key of ["userEnv", "passwordEnv"]) if (str(role[key])) roleVars.push(str(role[key]).trim());
}
const trackerHosts = [];
for (const source of sources) {
  if (!source || typeof source !== "object") continue;
  for (const key of ["url", "mcpUrl"]) {
    try { if (str(source[key])) trackerHosts.push(new URL(source[key]).hostname.toLowerCase()); } catch (e) { /* not a URL */ }
  }
}
// A QA run or a hunt: the id of the record the shell picked (run-records.mjs validated it).
let ticket = str(process.argv[4]).trim();
if (!ticket) {
  // The autopilot marker is JSON: { ticket, branch, scope }. Its ticket id serves the same role.
  try { ticket = str(JSON.parse(fs.readFileSync(path.join(root, ".ultrapowers", "autopilot-active"), "utf8")).ticket).trim(); } catch (e) { ticket = ""; }
}
// The ticket or audit id names the write area reviews/<id>/: an id with a parent segment or a path
// separator would widen it, so a marker holding one is refused for every call.
if (ticket && (ticket.includes("..") || /[\/\\]/.test(ticket))) {
  process.stdout.write(["badmarker", "", "", "", "", "", "", "", ""].join("\0") + "\0");
  process.exit(0);
}
// Facts about the run marker for every deny message: how long ago it was written, and the stage
// an autopilot marker records. A marker that outlived its run is for the human partner to end.
let markerAge = "";
let markerStage = "";
try {
  const started = str(process.argv[5]).trim();
  const marker = path.join(root, ".ultrapowers", "autopilot-active");
  const since = started ? Date.parse(started) : fs.statSync(marker).mtimeMs;
  const seconds = Math.max(0, Math.round((Date.now() - since) / 1000));
  if (Number.isFinite(seconds)) markerAge = seconds < 60 ? "<1m" : seconds < 3600 ? Math.floor(seconds / 60) + "m" : seconds < 172800 ? Math.floor(seconds / 3600) + "h" : Math.floor(seconds / 86400) + "d";
  if (!started) markerStage = str(JSON.parse(fs.readFileSync(marker, "utf8")).stage).trim();
} catch (e) { /* no facts: the deny message omits them */ }
// Every path-shaped field any tool carries (a read, a search, an upload), for the
// key-material check that applies to all tools, not only to file writes.
const pathFields = [];
// The glob a search tool narrows its files with (Grep glob, include, file_pattern): files whose content it reads,
// so a glob that can expand to a key name is judged like a key path (the shell cannot be asked to expand it here).
const globFields = [];
// Keys are compared with case and separators folded (file_path, filePath, FilePath; AbsolutePath,
// absolute_path; DirectoryPath, dir_path; Url).
const PATH_KEYS = new Set(["filepath", "notebookpath", "path", "source", "destination", "destinationpath", "filename", "absolutepath", "dirpath", "directorypath", "url", "uri", "targetfile", "targetpath", "target", "searchdirectory", "file", "folder", "directory", "outputpath", "newpath"]);
for (const [key, value] of Object.entries(inp)) {
  const k = key.toLowerCase().replace(/[_-]/g, "");
  if (PATH_KEYS.has(k) && str(value)) pathFields.push(str(value));
  if ((k === "paths" || k === "files" || k === "filepaths" || k === "absolutepaths") && Array.isArray(value)) for (const v of value) if (str(v)) pathFields.push(str(v));
  if (["glob", "globs", "include", "includes", "filepattern", "filepatterns"].includes(k)) {
    for (const v of Array.isArray(value) ? value : [value]) if (str(v)) { globFields.push(str(v)); pathFields.push(str(v)); }
  }
}
{
  const dir = str(inp.dir_path) || str(inp.DirectoryPath);
  const name = str(inp.file_name) || str(inp.fileName);
  if (dir && name) pathFields.push(dir.replace(/[\\/]+$/, "") + "/" + name);
}
// Every string value of the input that is a URL by itself (a navigation target, a page to scrape, a
// fetch address) under whatever key or nesting a harness spells it; text that merely contains a
// URL (a file body, a prompt) is not an address.
const urlValues = [];
const scanUrls = (v, depth) => {
  if (depth > 6) return;
  if (typeof v === "string") { if (/^\s*[a-z][a-z0-9+.-]*:\/\/\S+\s*$/i.test(v)) urlValues.push(v.trim()); }
  else if (Array.isArray(v)) { for (const x of v) scanUrls(x, depth + 1); }
  else if (v && typeof v === "object") { for (const x of Object.values(v)) scanUrls(x, depth + 1); }
};
scanUrls(inp, 0);
// A patch tool may carry its patch under another field than command (Codex, Hermes); only a
// patch tool reads those fields, so free text of another tool is never taken for a command.
const isPatchTool = /patch/i.test(toolName);
const command = str(inp.command) || (isPatchTool ? (str(inp.patch) || str(inp.patchText) || str(inp.input) || str(inp.diff)) : "");
// The path resolver is an ES module: import() works on every node this plugin supports (18+).
import(require("node:url").pathToFileURL(path.join(process.argv[2], "lib", "guard-paths.mjs")).href).then((guard) => {
  // Every path below is resolved to its real spelling (8.3 short names, Git Bash forms, symlinks)
  // against the event cwd, and compared exactly unless the project folder ignores case. The bash
  // rules then match on these trusted values: `real` is the full canonical path, `rel` the path
  // inside the project written "./<path>" (empty when the path is outside it).
  let base = process.argv[3] || process.cwd();
  try { if (str(ev.cwd) && fs.statSync(guard.toNative(str(ev.cwd))).isDirectory()) base = str(ev.cwd); } catch (e) { /* keep the found root or the process cwd */ }
  const rootReal = guard.realCanonical(root, root);
  const ignoreCase = guard.rootIgnoresCase(root);
  // A tool call may carry its own working directory (OpenCode workdir, Hermes working_directory,
  // Gemini dir_path, Antigravity Cwd, Cursor and Codex cwd): relative targets resolve against it,
  // and one outside the project is reported to the shell rules.
  let workdirState = "";
  let workdirReal = "";
  const fileName = str(inp.file_name) || str(inp.fileName) || str(inp.FileName);
  for (const key of ["workdir", "working_directory", "workingDirectory", "dir_path", "Cwd", "cwd"]) {
    if (!str(inp[key]).trim()) continue;
    if (key === "dir_path" && fileName) continue; // the directory of a file name, not a working directory
    workdirReal = guard.realCanonical(str(inp[key]).trim(), base);
    if (guard.rel(workdirReal, rootReal, ignoreCase) === null) workdirState = "outside"; else { workdirState = "ok"; base = workdirReal; }
    break;
  }
  const resolve = (p) => {
    const real = guard.realCanonical(p, base);
    const inner = guard.rel(real, rootReal, ignoreCase);
    return { real, rel: inner === null ? "" : "./" + inner };
  };
  // The written path under its known spellings; a move or copy writes its destination.
  // The key spellings differ by harness (file_path, filePath, TargetFile, AbsolutePath, absolute_path,
  // Path): they are compared with case and separators folded; a file name next to a directory
  // (Gemini dir_path + file_name) is the path they make together.
  const fold = (k) => k.toLowerCase().replace(/[_-]/g, "");
  let writeRaw = "";
  for (const want of ["filepath", "notebookpath", "path", "absolutepath", "destination", "destinationpath", "target", "targetfile", "targetpath", "outputpath", "newpath"]) {
    const hit = Object.entries(inp).find(([k, v]) => fold(k) === want && str(v));
    if (hit) { writeRaw = str(hit[1]); break; }
  }
  if (!writeRaw && fileName && str(inp.dir_path)) writeRaw = str(inp.dir_path).replace(/[\\/]+$/, "") + "/" + fileName;
  // A call that spells its file twice (path, file_path, filePath, notebook_path) under different
  // targets: the rules above judge one spelling, the tool may write the other.
  const spellings = Object.entries(inp).filter(([k, v]) => ["filepath", "notebookpath", "path"].includes(fold(k)) && str(v)).map(([, v]) => str(v));
  const targets = new Set(spellings.map((p) => { const r = resolve(p).real; return ignoreCase ? r.toLowerCase() : r; }));
  if (targets.size > 1) {
    process.stdout.write(["twotargets:" + spellings.join(", "), "", "", "", "", "", "", "", ""].join("\0") + "\0");
    process.exit(0);
  }
  const w = writeRaw ? resolve(writeRaw) : { real: "", rel: "" };
  const keyReal = pathFields.map((p) => { const r = resolve(p); return r.rel ? r.rel.slice(2) : r.real; }).filter(Boolean);
  // The files a patch names (Codex apply_patch, Droid ApplyPatch), each as raw, rel and real.
  const patchRecs = [];
  // Any tool whose name holds "patch" (apply_patch, OpenCode patch, Hermes patch in V4A mode) can
  // carry such a patch under command, patch, patchText, input or diff.
  if (isPatchTool) {
    for (const line of command.split(/\r?\n/)) {
      const m = /^\s*\*\*\* (?:Add|Update|Delete) File:\s*(.+?)\s*$/.exec(line) || /^\s*\*\*\* Move to:\s*(.+?)\s*$/.exec(line);
      if (!m) continue;
      const r = resolve(m[1]);
      patchRecs.push([m[1], r.rel, r.real].join("\u0001"));
    }
  }
  process.stdout.write([
    "ok", toolName, command, writeRaw,
    [...new Set([inp.url, inp.uri, inp.link].concat(Array.isArray(inp.urls) ? inp.urls : [inp.urls]).map((u) => str(u).trim().replace(/\s+/g, "\\")).concat(urlValues).filter(Boolean))].join(" "), str(ev.cwd), allowed.join(","), norm(hosts.forbidden).join(","), ticket,
    pathFields.join("\n"), trackerHosts.join(","), ignoreCase ? "1" : "0",
    w.real, w.rel, keyReal.join("\n"), patchRecs.join("\n"), roleVars.join(","),
    str((qa.db && typeof qa.db === "object" ? qa.db : {}).roRole).trim() || "qa_agent_ro",
    markerAge, markerStage,
    // The QA baseline file (qa.knownIssues) inside the project, "" when it is not set or lies outside.
    str(qa.knownIssues).trim() ? resolve(path.resolve(root, str(qa.knownIssues).trim())).rel.replace(/^\.\//, "") : "",
    workdirState, workdirReal,
    globFields.find((g) => guard.keyGlobReaches(g)) || "",
    // The MCP servers of the snapshot the ticket began with (an autopilot stage reaches only these), names folded the way
    // the hook folds the server of a tool name.
    (() => { try { return Object.keys(JSON.parse(fs.readFileSync(path.join(root, ".ultrapowers", "autopilot", "mcp.json"), "utf8").replace(/^\uFEFF/, "")).mcpServers || {}).map((n) => n.toLowerCase().replace(/[^a-z0-9]/g, "_")).join(","); } catch (e) { return ""; } })(),
  ].join("\0") + "\0");
}, (e) => {
  process.stdout.write(["noresolver:" + String(e.message).split("\n")[0], "", "", "", "", "", "", "", ""].join("\0") + "\0");
});
' "$root_node" "$hook_dir_node" "$root_start_node" "$RUN_ID" "$RUN_STARTED")
case "$parse_status" in
  noresolver:*) deny "the path resolver hooks/lib/guard-paths.mjs cannot be loaded (${parse_status#noresolver:}); every call is refused during $run_kind" ;;
  badconfig:*) deny "the project config .agents/ultrapowers.json cannot be read (${parse_status#badconfig:}); every call is refused while a run is active" ;;
  shapeless) deny "the tool event has no readable tool name or input; an uninspectable call is refused during $run_kind" ;;
  badmarker) deny "the run marker holds a ticket or audit id with a parent segment or a path separator; every call is refused while it does" ;;
  twotargets:*) deny "the call names two different targets (${parse_status#twotargets:}); one call writes one file" ;;
esac
[ "$parse_status" = "ok" ] || deny "the tool event could not be parsed; an uninspectable call is refused during $run_kind"

# Prefer the event's real cwd for the root and for resolving relative paths: on Windows the
# harness spells it `S:\proj` while the process cwd is `/s/proj`; both normalize alike.
base_cwd="$(norm_path "$PWD")"
# A root found from workspace_roots[0] or CURSOR_PROJECT_DIR: the hook runs from the plugin folder
# there, so relative paths resolve against the project directory the harness named.
[ -n "$root_start" ] && base_cwd="$root_start"
if [ -n "$event_cwd" ]; then
  ev_norm="$(norm_path "$event_cwd")"
  if [ -d "$ev_norm" ]; then
    base_cwd="$ev_norm"
    # Through the bridge the event cwd is the call's own directory, which the bridge bounded to the
    # run it found; the root stays the one ULTRAPOWERS_RUN_DIR gave, so both judge the same run.
    # find_root_r runs in this shell, not a command substitution: a deny inside pick_run_r must end the hook, and
    # the profile and run it picks (PROFILE, RUN_ID, RUN_FILE, RUN_STARTED) are the ones this call is judged by.
    if [ -z "${ULTRAPOWERS_RUN_DIR+x}" ] && find_root_r "$ev_norm"; then
      root="$REPLY"
      [ "$PROFILE" = "corrupt" ] && deny "a run record cannot be read ($RUN_FILE); every call of this project is refused while it exists. Your human partner removes that file"
      GUARD_PREFIX="QA-GUARDRAIL"; run_kind="a QA run"
      [ "$PROFILE" = "autopilot" ] && { GUARD_PREFIX="AUTOPILOT-GUARDRAIL"; run_kind="an autopilot stage"; }
      [ "$PROFILE" = "hunt" ] && { GUARD_PREFIX="HUNT-GUARDRAIL"; run_kind="a vulnerability hunt"; }
    fi
  fi
fi

# The call's own working directory (workdir, working_directory, dir_path, Cwd): the write analyzer
# resolves relative targets against it, as the node block did for the file tools.
[ "$workdir_state" = "ok" ] && base_cwd="$(norm_path "$workdir_real")"

tool_lc="$(lower "$tool")"

# The PowerShell tool (Claude Code's `PowerShell`, Copilot CLI's `powershell`) runs its command in
# PowerShell, and every shell rule below reads POSIX shell: `sc`, `ri`, `iex` and .NET calls would
# pass, the run's own marker among them. The Bash tool is the shell of a run.
# The session-control forms (list, read, stop) carry no command and pass; the write form types into a
# running shell and is refused with the rest.
case "$tool_lc" in
  list_powershell|read_powershell|stop_powershell) ;;
  *powershell*) deny "the PowerShell tool is not analysed during $run_kind; use the Bash tool" ;;
esac

# Key material: never read, searched, uploaded or written by any tool during a run. A
# `.env.example` file is the documented template and stays readable.
KEY_RE='(^|/)\.ssh(/|$)|authorized_keys|id_rsa|id_ed25519|id_ecdsa|(^|/)\.aws(/|$)|mcp-secrets\.env|secrets\.local|\.local\.sh|(^|/)\.env($|\.)|\.git-credentials|(^|/)\.netrc$|(^|/)\.npmrc$|(^|/)\.config/(gh|glab-cli)(/|$)|(^|/)\.docker/config\.json|(^|/)\.kube(/|$)|(^|/)\.gnupg(/|$)|(^|/)\.pypirc$|(^|/)\.cargo/credentials(\.toml)?$|(^|/)\.config/gcloud(/|$)|(^|/)\.azure(/|$)|(^|/)\.pgpass$|(^|/)\.vault-token$|(^|/)\.gem/credentials$|(^|/)[A-Za-z0-9_][^]/[|]*\.(pem|key|pfx|p12)(\.(bak|old|orig))?$'
# A process folder of /proc holds that process's environment and command line: no file tool reads or
# searches one, nor /proc as a whole (the shell has its own rules for the same paths).
PROC_RE='^/proc/?$|^/proc/([0-9]+|self|thread-self|[^/]*[*?[][^/]*)(/|$)|^/proc/.*environ'
proc_check_r() {
  local p="$1"
  while [[ "$p" == */./* ]]; do p="${p//\/.\//\/}"; done
  [[ "$p" =~ $PROC_RE ]] && deny "reading a process environment or a process folder of /proc ($2) is blocked during $run_kind; check a variable with \${NAME:+set} instead"
  return 0
}
if [ -n "$keypaths" ]; then
  while IFS= read -r kp; do
    [ -n "$kp" ] || continue
    norm_path_r "$kp"; lower_r "$REPLY"; kl="${REPLY//.env.example/}"
    [[ "$kl" =~ $KEY_RE ]] && deny "key material ($kp) is never read, searched, uploaded or written during $run_kind"
    proc_check_r "$kl" "$kp"
  done <<< "$keypaths"
fi
# The same paths again in their real spelling: an 8.3 short name or a symlink names the key file
# while the text above does not.
if [ -n "$keypaths_real" ]; then
  while IFS= read -r kp; do
    [ -n "$kp" ] || continue
    lower_r "$kp"; kl="${REPLY//.env.example/}"
    [[ "$kl" =~ $KEY_RE ]] && deny "key material ($kp) is never read, searched, uploaded or written during $run_kind"
    proc_check_r "$kl" "$kp"
  done <<< "$keypaths_real"
fi

[ -z "$keyglob" ] || deny "key material (the glob $keyglob can expand to a key name) is never read, searched, uploaded or written during $run_kind; name the file"

# --- File tools. QA profile: the only legitimate writes are the report, its artifacts and
# run-state under reviews/<ticket>/, plus the run's own state under .ultrapowers/. Autopilot
# profile: anywhere under the workspace root. Protected paths are refused in both (this closes
# the loop where the agent edits the guardrail, the config, CI, harness settings or key material).
# Named targets, not folder names: `src/hooks/` of a React app and `appsettings.json` of a .NET
# app are ordinary implementation files. The ticket's state files are the gate's record.
PROTECTED_RE='(^|/)\.ssh(/|$)|authorized_keys|id_rsa|id_ed25519|id_ecdsa|(^|/)\.aws(/|$)|mcp-secrets\.env|\.local\.(sh|env|json)$|hooks/qa-guardrail|\.agents/ultrapowers\.json|(^|/)\.claude/|(^|/)\.git/|(^|/)\.git$|(^|/)\.githooks/|(^|/)\.[a-z0-9_-]+/settings(\.local)?\.json$|(^|/)tasks/[^/]+/(autopilot\.json|stage-log\.jsonl|changes-comments\.md)$|(^|/)\.ultrapowers/(autopilot-active|autopilot-stop)$|(^|/)\.ultrapowers/autopilot(/|$)|(^|/)\.ultrapowers$'
# The autopilot envelope also keeps the agent out of CI, the plugin hooks, the repository's commit
# hooks (they run inside the engine's own commit and push) and the env file: a stage that
# rewrites the workflow or the hooks rewrites its own brakes.
AUTOPILOT_PROTECTED_RE='(^|/)\.github/|(^|/)\.gitlab-ci\.yml$|(^|/)hooks/(qa-guardrail|session-start|team-memory-[a-z]+|lib/|hooks(-cursor|-codex)?\.json|run-hook\.cmd)|(^|/)\.gemini/hooks/|(^|/)\.husky/|(^|/)\.pre-commit-config\.ya?ml$|(^|/)lefthook\.ya?ml$|(^|/)\.env($|\.)|(^|/)qa/known-issues\.md$|^(agents|claude|gemini)\.md$|(^|/)\.ultrapowers/(autopilot-active|autopilot-stop)$|(^|/)\.ultrapowers/runs(/|$)|(^|/)\.mcp\.json$|(^|/)\.cursor/(mcp\.json|cli\.json|environment\.json|worktrees\.json|rules/|hooks/)|(^|/)\.devcontainer(/|\.json$)|(^|/)\.vscode/|(^|/)\.codex/|(^|/)\.kimi/|(^|/)\.factory/|(^|/)\.gemini/|(^|/)\.qwen/|(^|/)opencode\.jsonc?$|(^|/)\.hermes/|(^|/)\.opencode/|(^|/)\.cursor/hooks\.json$|(^|/)\.pi/|(^|/)\.claude-plugin/|(^|/)hooks\.json$'
# The QA baseline (known-issues) and the instruction files every later session obeys are the gate's
# record and the agents' rules: a stage that edits its own baseline hides a failure from the QA
# gate. The baseline's path is qa.knownIssues (default qa/known-issues.md, matched above).
known_lc="$(lower "$known_issues")"
# The QA and hunt run records: never written, moved or removed by a call of a run, through a file tool,
# a patch or the shell. A run ends itself through hooks/lib/run-records.mjs end, which removes its
# record only once its report holds its Verdict line (and logs the end in reviews/<id>/run-log.txt).
MARKER_RE='(^|/)\.ultrapowers/runs(/|$)'
MARKER_WHY="is a run record; no call of a run writes, moves or removes one: the run ends itself through run-records.mjs end once its report holds its Verdict line"
# --- MCP tools of a tracker, of mail or chat, or of git (git: autopilot only): reads pass; in an autopilot stage writes belong to the
# engine between stages (the approve label among them). A tool name with a read verb is a read.
# This rule comes before the file-tool gate: a tracker tool that carries a `path` argument
# (create_or_update_file, delete_file) is a tracker write, not a workspace write.
# The harnesses spell an MCP tool differently: mcp__<server>__<tool> (Claude Code), <server>_<tool>
# (OpenCode), mcp_<server>_<tool> (Hermes), MCP:<tool> (Cursor, no server). The name is judged
# normalised: lowercase, `-`, `:`, `.`, `/` and spaces as `_`, a leading `mcp` marker removed.
# Shell builtins only until a tracker word is seen.
if [ -n "$PROFILE" ]; then
  tool_norm="$tool_lc"
  tool_norm="${tool_norm//-/_}"; tool_norm="${tool_norm//:/_}"; tool_norm="${tool_norm//./_}"
  tool_norm="${tool_norm// /_}"; tool_norm="${tool_norm//\//_}"
  tool_server_less=0
  case "$tool_lc" in mcp:*) tool_server_less=1 ;; esac
  case "$tool_norm" in mcp_*) tool_norm="${tool_norm#mcp}" ;; esac
  while [[ "$tool_norm" == *__* ]]; do tool_norm="${tool_norm//__/_}"; done
  while [[ "$tool_norm" == _* ]]; do tool_norm="${tool_norm#_}"; done
  tracker_re='github|gitlab|glab|jira|linear|odoo|bitbucket|azure_?devops|^tickets_|outlook|microsoft_365|gmail|slack|teams'
  # Cursor's MCP:<tool> carries no server name: the object of the tool says it is a tracker's.
  object_re='(^|_)(issue|issues|pull_request|pull_requests|merge_request|merge_requests|pr|mr|comment|comments|label|labels|milestone|discussion|work_item|workitem|ticket)(_|$)'
  if [[ "$tool_norm" =~ $tracker_re ]] || { [ "$tool_server_less" -eq 1 ] && [[ "$tool_norm" =~ $object_re ]]; }; then
    read_re='(^|_)(get|list|search|read|view|fetch|show|describe|find|query|resolve)(_|$)'
    write_re='(create|update|edit|add|remove|delete|merge|comment|note|label|close|reopen|post|save|accept|push|fork|assign|transfer|lock|approve|submit|publish|manage|link|call|execute|write|unlink|method|send|reply|chat|cancel|transition|trigger|dispatch|(^|_)(run|rerun|retry|play|start|invoke|restart)(_|$))'
    # The verbs are read from the name with its camel-case words split (rerunWorkflow is rerun_workflow, RunWorkflow run_workflow); a
    # name with no capital reads as it did. The tracker word above is read from the name unsplit (GitHub stays github).
    tool_words="$tool"
    camel_re='([[:lower:][:digit:]])([[:upper:]])'
    while [[ "$tool_words" =~ $camel_re ]]; do
      cw_pair="${BASH_REMATCH[0]}"; cw_new="${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
      tool_words="${tool_words/$cw_pair/$cw_new}"
    done
    lower_r "$tool_words"; tool_words="$REPLY"
    tool_words="${tool_words//-/_}"; tool_words="${tool_words//:/_}"; tool_words="${tool_words//./_}"
    tool_words="${tool_words// /_}"; tool_words="${tool_words//\//_}"
    case "$tool_words" in mcp_*) tool_words="${tool_words#mcp}" ;; esac
    while [[ "$tool_words" == *__* ]]; do tool_words="${tool_words//__/_}"; done
    while [[ "$tool_words" == _* ]]; do tool_words="${tool_words#_}"; done
    if ! [[ "$tool_words" =~ $read_re ]] && { [[ "$tool_norm" =~ $write_re ]] || [[ "$tool_words" =~ $write_re ]]; }; then
      if [ "$PROFILE" = "autopilot" ]; then
        deny "tracker writes through MCP tools are never run by an autopilot stage; the engine writes back between stages"
      else
        deny "tracker and mail writes through MCP tools are never run during $run_kind; the run reads, it does not post"
      fi
    fi
  fi
  # An MCP call whose server or tool name could not be read (guardrail-cli.mjs maps it so) is judged by
  # nothing: refused in every run.
  case "$tool_lc" in mcp__unreadable__*) deny "an MCP call whose server or tool name cannot be read is refused during $run_kind" ;; esac
  # An autopilot stage reaches only the MCP servers of the ticket's snapshot (.ultrapowers/autopilot/mcp.json,
  # taken at begin): a harness that loads the user's own servers (a connector, a tracker, mail) is held to the
  # project's list. Judged where the name carries its server: mcp__<server>__<tool>.
  if [ "$PROFILE" = "autopilot" ] && [[ "$tool_lc" == mcp__?*__?* ]]; then
    mcp_srv="${tool_lc#mcp__}"; mcp_srv="${mcp_srv%%__*}"; mcp_srv="${mcp_srv//[^a-z0-9]/_}"
    [[ ",$mcp_servers," == *",$mcp_srv,"* ]] \
      || deny "the MCP server '$mcp_srv' is not in the ticket's snapshot of .mcp.json; an autopilot stage reaches only the servers the project lists"
  fi
  # Cursor's MCP:<tool> carries no server name, so the snapshot cannot judge it: refused in an autopilot
  # stage (OpenCode's and Hermes' spellings are turned into mcp__<server>__<tool> by their adapters).
  if [ "$PROFILE" = "autopilot" ] && [ "$tool_server_less" -eq 1 ]; then
    deny "the MCP server of this call cannot be read (Cursor's MCP:<tool> names no server); an autopilot stage reaches only the servers the project lists"
  fi
  git_mcp_re='(^|_)git_git_(push|reset)|^git_(push|reset)'
  if [ "$PROFILE" = "autopilot" ] && [[ "$tool_norm" =~ $git_mcp_re ]]; then
    deny "git push and git reset through an MCP tool are never run by an autopilot stage"
  fi
fi

# --- The hunt: its network is its audit tools and gh/glab api, called from the shell. This runs before the
# write rules, so a path field in a tool's input cannot carry an unknown tool past it (GH-59 review).
# A fetch or search tool, and any tool whose input holds a url, is refused whatever qa.hosts lists; the
# local file readers are not URL tools (a search for a URL string is a file search). Then a tool the
# hunt does not use is refused by default, whatever its name: research tools (search, documentation,
# scrape) have no fixed names, and a query can carry data out. The hunt's own tools pass: the write
# tools (the write rules below judge their paths), the shell tools (the shell rules below judge the
# command), the file readers, subagent dispatch and its lifecycle, task tracking, skills, asking the
# user, loading a tool's schema, and tracker and mail reads (the tracker rule above has refused their
# writes; for an `mcp__<server>__<tool>` name the tracker word must be a whole segment of the server).
# Research belongs to STEP 0b of the hunt contract, before the run record is started. Names are matched
# lowercased, without `_ :.-/`.
if [ "$PROFILE" = "hunt" ]; then
  tool_flat="${tool_lc//[_ :.-]/}"
  tool_flat="${tool_flat////}"
  case "$tool_flat" in
    webfetch|websearch|*googlewebsearch*|*fetchurl*|*urlfetch*|*searchweb*|*webbrowse*|*webread*) deny "the hunt's network is its audit tools and gh api; $tool is refused" ;;
  esac
  if [ -n "$url" ]; then
    case "$tool_lc" in
      read|grep|glob|ls|lsp|notebookread|read_file|read_many_files|list_directory|grep_search|search_file_content|find_by_name|view_file|list_dir|codebase_search|file_search) ;;
      *) deny "the hunt's network is its audit tools and gh api; $tool carrying a URL is refused" ;;
    esac
  fi
  hunt_write_re='^(write|edit|multiedit|notebookedit|create|applypatch|writefile|replace|editfile|writetofile|replacefilecontent|multireplacefilecontent|strreplacefile|patch|newfile)$'
  hunt_shell_re='^(bash|shell|runshellcommand|terminal|runterminalcmd|runcommand|execute|exec|execcommand|executecommand|powershell|monitor)$'
  # The report and lifecycle tools are in the list on purpose: a subagent returns its lane block
  # through its harness's hand-back tool, and a long audit command is polled and stopped through
  # the read, list and stop forms of the shell session tools. The write forms (write_bash,
  # write_powershell, write_stdin) type into a running shell, and the shell rules below never see
  # that text, so they stay refused with their own reason.
  hunt_tools_re='^(read|readfile|readmanyfiles|notebookread|view|viewfile|viewfileoutline|viewimage|grep|glob|ls|list|lsp|find|listdirectory|listdir|grepsearch|searchfilecontent|findbyname|codebasesearch|filesearch|search|searchfiles|agent|task|invokesubagent|invokeagent|delegatetask|subagentspawn|subagent|spawnagent|waitagent|listagents|followuptask|closeagent|completetask|subagenthandback|sendmessage|sendusermessage|brief|exitplanmode|enterplanmode|listmcpresourcestool|listmcpresources|managetask|commandstatus|readbash|listbash|stopbash|readpowershell|listpowershell|stoppowershell|todowrite|todoread|todolist|writetodos|todo|updatetodo|updateplan|settodolist|taskcreate|taskupdate|tasklist|taskget|taskoutput|taskstop|bashoutput|killshell|trackeradddependency|trackercreatetask|trackergettask|trackerlisttasks|trackerupdatetask|trackervisualize|skill|skills|skillslist|activateskill|skillview|askuserquestion|requestuserinput|askuser|clarify|question|toolsearch|think)$'
  case "$tool_flat" in
    writebash|writepowershell|writestdin) deny "the hunt's network is its audit tools and gh api; $tool types into a running shell, and input to a running shell is never judged by the shell rules" ;;
  esac
  hunt_tracker_re='(^|_)(github|gitlab|glab|jira|linear|odoo|bitbucket|azure_?devops|outlook|microsoft_365|gmail|slack|teams)(_|$)|^tickets_'
  tracker_name="$tool_norm"
  case "$tool_lc" in
    mcp__*__*) tracker_name="${tool_lc#mcp__}"; tracker_name="${tracker_name%%__*}"; tracker_name="${tracker_name//-/_}"; tracker_name="${tracker_name//./_}" ;;
  esac
  tracker_read=0
  if [[ "$tracker_name" =~ $hunt_tracker_re ]] || { [ "$tool_server_less" -eq 1 ] && [[ "$tool_norm" =~ $object_re ]]; }; then tracker_read=1; fi
  if ! [[ "$tool_flat" =~ $hunt_write_re ]] && ! [[ "$tool_flat" =~ $hunt_shell_re ]] && ! [[ "$tool_flat" =~ $hunt_tools_re ]] && [ "$tracker_read" -eq 0 ]; then
    deny "the hunt's network is its audit tools and gh api; $tool is not a tool the hunt uses (research belongs to STEP 0b, before the run record is started)"
  fi
fi

is_write_tool=0
case "$tool" in
  Write|Edit|MultiEdit|NotebookEdit|Create|ApplyPatch) is_write_tool=1 ;;
  *)
    # The other harnesses' spellings: Gemini's write_file and replace, Droid's Create, Antigravity's
    # write_to_file and replace_file_content, Codex's apply_patch (handled below, it carries a patch).
    case "$tool_lc" in
      *write*|*edit*|*create*|*move_file*|*copy_file*|*delete*|replace|*replace_file*|*patch*)
        [ -n "$wpath" ] && is_write_tool=1 ;;
    esac
    # A write-named file tool (StrReplaceFile, write_file, ...) is a write whether or not its path
    # can be read: without one the call is refused below.
    file_write_re='(write|edit|create|delete|replace|move|copy|rename|patch|insert|append|save|remove).*(file|notebook)|(file|notebook).*(write|edit|create|delete|replace|move|copy|rename|patch|insert|append|save|remove)'
    [[ "$tool_lc" =~ $file_write_re ]] && is_write_tool=1
    # Any other tool that carries a path-shaped field writes it, unless it is a reader.
    read_only_re='^(read|ls|cat|glob|grep|lsp|open|stat|tree|find|view)|read|list|grep|glob|search|view|find|symbol|definition|reference|diagnostic|hover|artifact|get_|fetch|stat|tree|show|info|exists'
    if [ "$is_write_tool" -eq 0 ] && [ -n "$wpath" ] && ! [[ "$tool_lc" =~ $read_only_re ]]; then is_write_tool=1; fi ;;
esac

# A command or a write run from a directory outside the project cannot be judged by the project's
# rules: its relative targets land elsewhere.
if [ "$workdir_state" = "outside" ] && { [ -n "$cmd" ] || [ "$is_write_tool" -eq 1 ]; }; then
  deny "the call's working directory ($workdir_real) is outside the project $root; commands and writes run from outside it cannot be verified"
fi

# Codex and Droid apply edits through a patch (apply_patch, ApplyPatch): the patch text names the
# files. Every named file is checked as a write; the patch is not a shell command, so the
# command rules below do not see it.
# A patch tool that names files in its patch text is judged by those files; one that names none
# (a path-and-text edit of the Hermes patch tool) goes through the write-tool rules below.
patch_mode=0
case "$tool_lc" in
  *patch*) if [ -n "$patch_recs" ] || [ "$tool_lc" = "apply_patch" ] || [ "$tool_lc" = "applypatch" ]; then patch_mode=1; fi ;;
esac
case "$patch_mode" in
  1)
    [ -n "$cmd" ] || deny "an empty patch cannot be verified during $run_kind"
    [ -n "$patch_recs" ] || deny "a patch that names no file cannot be verified during $run_kind"
    # Each record: the path as written, its path inside the project ("./..." or empty when the
    # path is outside it) and its real canonical path, resolved by the node block.
    while IFS=$'\001' read -r ppath prel preal; do
      [ -n "$ppath" ] || continue
      pcheck="${prel:-$preal}"
      # No process per record (see lower_r): a patch may name hundreds of files.
      lower_r "${pcheck#./}"; pl="$REPLY"
      [[ "$pl" =~ $PROTECTED_RE ]] \
        && deny "the patch writes a protected path ($ppath); never allowed during $run_kind"
      [ "$PROFILE" != "autopilot" ] && [[ "$pl" =~ $MARKER_RE ]] \
        && deny "the patch target ($ppath) $MARKER_WHY"
      if [ "$PROFILE" = "autopilot" ]; then
        pl_noex="${pl//.env.example/}"
        [[ "$pl_noex" =~ $AUTOPILOT_PROTECTED_RE ]] \
          && deny "the patch writes a protected path ($ppath); CI, hooks, settings and the project config stay as they are"
        [ -n "$known_lc" ] && [ "${pl%/}" = "$known_lc" ] \
          && deny "the patch writes the QA baseline ($ppath); a stage never edits its own known-issues file"
      fi
      norm_path_r "$ppath"; lower_r "$REPLY"
      case "$REPLY" in
        ..|../*|*/../*|*/..) deny "the patch names a path with a parent-directory segment ($ppath)" ;;
      esac
      if [ "$PROFILE" = "autopilot" ]; then
        [ -n "$prel" ] || deny "the patch writes outside the workspace $root ($ppath)"
      else
        prc="${prel#./}"
        if [ "$ignore_case" = "1" ]; then lower_r "$prc"; prc="$REPLY"; fi
        case "$prc" in reviews/*|.ultrapowers/*) ;; *) deny "a patch during $run_kind is limited to reviews/ and .ultrapowers/ ($ppath)" ;; esac
      fi
    done <<< "$patch_recs"
    exit 0 ;;
esac

if [ "$is_write_tool" -eq 1 ]; then
  # A write tool whose path the hook cannot read (an unknown key) is a write that cannot be judged.
  [ -n "$wpath" ] || deny "a write tool without a readable path cannot be verified during $run_kind"
  # The protected-name rules judge the path inside the project (or the full canonical path when
  # it lies outside); both come from the node block, resolved to the real spelling.
  wcheck="${wpath_rel:-$wpath_real}"
  wl="$(lower "${wcheck#./}")"
  # A directory-shaped name is judged as the folder that receives content (`.git` as a file, in a
  # nested worktree, points the engine's git at a config the stage wrote): path and path/_ both.
  { printf '%s\n' "$wl"; printf '%s\n' "$wl/_"; } | grep -Eq "$PROTECTED_RE" \
    && deny "write to a protected path ($wpath) is never allowed during $run_kind"
  [ "$PROFILE" != "autopilot" ] && [[ "$wl" =~ $MARKER_RE ]] \
    && deny "the write target ($wpath) $MARKER_WHY"
  if [ "$PROFILE" = "autopilot" ]; then
    { printf '%s\n' "${wl//.env.example/}"; printf '%s\n' "${wl//.env.example/}/_"; } | grep -Eq "$AUTOPILOT_PROTECTED_RE" \
      && deny "write to a protected path ($wpath) is never allowed during an autopilot stage: CI, hooks, settings and the project config stay as they are"
    [ -n "$known_lc" ] && [ "${wl%/}" = "$known_lc" ] \
      && deny "write to the QA baseline ($wpath) is never allowed during an autopilot stage: a stage never edits its own known-issues file"
  fi
  case "$(lower "$(norm_path "$wpath")")" in
    ..|../*|*/../*|*/..) deny "write path with a parent-directory segment ($wpath) cannot be verified" ;;
  esac
  ok=0
  if [ "$PROFILE" = "autopilot" ]; then
    [ -n "$wpath_rel" ] && ok=1
    [ "$ok" -eq 1 ] || deny "writes during an autopilot stage stay inside the workspace $root (got: $wpath)"
    exit 0
  fi
  wrel="${wpath_rel#./}"
  tk="$ticket"
  if [ "$ignore_case" = "1" ]; then wrel="$(lower "$wrel")"; tk="$(lower "$ticket")"; fi
  if [ -n "$wpath_rel" ]; then
    if [ -n "$tk" ]; then
      case "$wrel" in "reviews/$tk/"*) ok=1 ;; esac
    else
      case "$wrel" in reviews/*) ok=1 ;; esac
    fi
    case "$wrel" in .ultrapowers/*) ok=1 ;; esac
  fi
  [ "$ok" -eq 1 ] || deny "writes during $run_kind are limited to reviews/${ticket:-<id>}/ and .ultrapowers/ (got: $wpath)"
  exit 0
fi

# --- Arbitrary in-page code is an egress and exfiltration bypass; never.
case "$tool_lc" in
  *run_code*|*execute_code*|*executecode*|*browser_evaluate*|*evaluate_script*|*javascript_tool*) deny "arbitrary in-page code execution is never allowed during $run_kind; it is an egress and exfiltration path no host list can see" ;;
esac

# The host of a URL in REPLY: scheme, userinfo, path and port removed, lowercase. Builtins only, so
# a call carrying hundreds of URLs costs no process per URL.
host_of_r() {
  local s="$1" a auth
  if [[ "$s" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then s="${s#*://}"; fi
  # The authority is what stands before the first `/` or `?`. A URL parser reads a backslash as a slash, a `#` as the
  # start of the fragment and the text after the LAST `@` as the host, so `http://127.0.0.1\@example.com/` and
  # `http://127.0.0.1#@example.com/` reach 127.0.0.1 while the userinfo strip below would judge example.com. A URL
  # with any of them, whitespace, or a second `@` in its authority is refused rather than judged.
  auth="${s%%[/?]*}"
  case "$auth" in
    *\\*|*'#'*|*[[:space:]]*|*@*@*) deny "the URL '$1' has a backslash, a #, whitespace or a second @ in its authority part; a URL parser reads it as another host than this guard does, so it is refused (write scheme://host/path)" ;;
  esac
  if [[ "$s" =~ ^[^/?@]*@ ]]; then s="${s#*@}"; fi
  a="${s%%[/?]*}"
  if [[ "$a" =~ :[0-9]+$ ]]; then a="${a%:*}"; fi
  lower_r "$a"
}
on_list() {
  # $1 comma-separated list, $2 host
  [ -n "$1" ] && [ -n "$2" ] && [[ ",$1," == *",$2,"* ]]
}

# --- Any tool that carries a url (navigation, fetch, scrape, crawl, whatever its name), under
# `url`, `uri`, `link` or a `urls` array: forbidden hosts never; allowed hosts only when a list is set.
# An autopilot stage has no open egress: a host that no list names is refused (the hook cannot read the
# ticket's own links, so a host to use is listed in qa.hosts.allowed; the ticket tracker's host stands for them
# while the list is empty). One exception: the autopilot spec, plan and changes stages research current sources
# (GH-59), so there a fetch, search or scrape tool may read any public host that qa.hosts.forbidden does not
# list (a forbidden host also covers its subdomains there, and a trailing dot changes nothing). Research reads
# public sources only: a loopback, link-local, private or single-label host, or an .internal, .local or
# .localhost name, needs qa.hosts.allowed or qa.urls even there, and a browser tool (it can type and click)
# keeps the listed-hosts rule. Any other stage, and a marker with no stage, keeps the listed-hosts rule.
research_stage=0; research_browser=0
if [ "$PROFILE" = "autopilot" ]; then
  case "$marker_stage" in spec|plan|changes) research_stage=1 ;; esac
  # A browser tool is told by its name (the harnesses and MCP servers spell them differently): the
  # browser words, the engine names and the automation servers. A browser tool whose name holds
  # none of these gets the fetch rule; that limit is documented in the README.
  case "$tool_lc" in *browser*|*navigate*|*playwright*|*puppeteer*|*chrome*|*chromium*|*firefox*|*webkit*|*devtools*|*selenium*|*stagehand*|*computer_use*|*computeruse*) [ "$research_stage" -eq 1 ] && research_browser=1; research_stage=0 ;; esac
fi
# 0 when the host in $1 is not a public one: loopback, link-local, private, unspecified, single-label, or a
# reserved local suffix. Builtins only.
non_public_host() {
  local h="${1#[}"; h="${h%]}"
  # An address in any form but plain dotted-decimal (a bare integer, a hex or octal segment) is
  # how a loopback or private address hides from a pattern; it is never a public host here.
  case "$h" in
    *0x*|*0X*) return 0 ;;
  esac
  if [[ "$h" =~ ^[0-9]+$ ]] || [[ "$h" =~ ^[0-9.]+$ && ( "$h" =~ (^|\.)0[0-9] ) ]]; then return 0; fi
  case "$h" in
    localhost|*.localhost|*.local|*.internal|*.lan|*.home.arpa) return 0 ;;
    127.*|0.0.0.0|0|10.*|192.168.*|169.254.*) return 0 ;;
    172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
    100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
    ::1|::|fe80:*|fc*:*|fd*:*|::ffff:*) return 0 ;;
    # Any other host with a colon is an IPv6 literal (the port is already gone): every one is non-public here
    # ([0:0:0:0:0:0:0:1], fe90::, ...); a research fetch has no business at a raw IPv6 address, and a public
    # host is named. Before the dotted pattern: an IPv4-mapped literal holds dots too.
    *:*) return 0 ;;
    *.*) return 1 ;;
    *) return 0 ;;
  esac
}
for u in $url; do
  host_of_r "$u"; h="$REPLY"
  on_list "$forbidden" "$h" && deny "host '$h' is on qa.hosts.forbidden"
  if [ "$research_stage" -eq 1 ]; then
    hd="${h%.}"
    for fh in ${forbidden//,/ }; do
      [ -n "$fh" ] && { [ "$hd" = "$fh" ] || [[ "$hd" == *".$fh" ]]; } && deny "host '$h' is on qa.hosts.forbidden (or under a host it lists)"
    done
    if ! on_list "$allowed" "$hd" && ! on_list "$tracker_hosts" "$hd" && non_public_host "$hd"; then
      deny "host '$h' is not a public host; an autopilot research stage reads public hosts only (list it in qa.hosts.allowed to use it)"
    fi
  elif [ "$research_browser" -eq 1 ] && ! on_list "$allowed" "$h" && ! on_list "$tracker_hosts" "$h"; then
    deny "host '$h' is not in qa.hosts.allowed; an autopilot research stage opens no browser on a host qa.hosts.allowed does not list (a browser can type and click)"
  elif [ -n "$allowed" ]; then
    on_list "$allowed" "$h" || deny "host '$h' is not in qa.hosts.allowed"
  elif [ "$PROFILE" = "autopilot" ]; then
    on_list "$tracker_hosts" "$h" || deny "host '$h' is not in qa.hosts.allowed or qa.urls; an autopilot stage reaches only listed hosts (the hook cannot read the ticket's own links, so list the host to use it)"
  fi
done

# --- Shell command surface.
[ -n "$cmd" ] || exit 0
lc="$(lower "$cmd")"

# Left boundary of a command word: start, a separator, whitespace, a quote, an opening
# parenthesis, a backtick or a path slash, so `sh -c "rm -rf x"`, `(rm -rf x)`,
# `$(curl ...)` and `/bin/rm` match like the bare spelling.
B="(^|[;&|[:space:]\"'(\`/\\\\])"

# Never push. Fail closed on any git command segment carrying a push token, `git stash push`
# excepted: it stores work locally and is the autopilot stage's way to set work aside.
push_why="the QA gate reads and reports, it never publishes"
[ "$PROFILE" = "autopilot" ] && push_why="the autopilot engine pushes between stages"
[ "$PROFILE" = "hunt" ] && push_why="the hunt reads and reports, it never publishes"
# One pass over the segments: a loop costs a process per `;`, `&` or `|`, so a long command could
# outlast the hook's timeout (and a timed-out hook lets the call through). A segment with the push
# token is a push unless it is a `git stash push` with no second push in it.
push_hits="$(printf '%s\n' "$lc" | tr ';&|' '\n' | grep -E '\bgit\b.*\bpush\b' || true)"
if [ -n "$push_hits" ]; then
  if printf '%s\n' "$push_hits" | grep -Evq '\bgit\b[^;&|]*\bstash[[:space:]]+push\b' \
    || printf '%s\n' "$push_hits" | grep -Eq '\bpush\b.*\bpush\b'; then
    deny "git push is never allowed during $run_kind; $push_why"
  fi
fi

if [ "$PROFILE" = "autopilot" ]; then
  # The engine merges nothing and the agent merges nothing: the ticket branch is the only branch.
  printf '%s' "$lc" | grep -Eq '\bgit\b[^;&|]*\b(merge|rebase|cherry-pick)\b' \
    && deny "git merge, rebase and cherry-pick are never run by an autopilot stage; the branch is integrated through its pull request"
fi

if [ "$PROFILE" = "autopilot" ] || [ "$PROFILE" = "hunt" ]; then
  tracker_why="the engine writes back between stages"
  [ "$PROFILE" = "hunt" ] && tracker_why="the hunt reports in its own files and never writes to a tracker"
  # Tracker writes belong to the engine, after the agent exits: comments, labels, pull requests,
  # releases, repository changes, and any gh/glab api call that is not a plain GET. The hunt writes
  # to no tracker at all (its --post is a separate step of the skill, after the run).
  # The api forms include the attached spellings (-XPOST, -flabels[]=, -Fbody=) and --input.
  printf '%s' "$lc" | grep -Eq "${B}gh(\\.exe)?[[:space:]][^;&|]*\\b(issue[[:space:]]+(comment|edit|close|reopen|create|delete|transfer|pin|unpin|lock|unlock|develop)|pr[[:space:]]+(create|merge|close|reopen|edit|ready|review|comment|checkout|lock|unlock)|label[[:space:]]|release[[:space:]]|repo[[:space:]]+(create|delete|edit|fork|archive|rename|sync)|secret[[:space:]]|variable[[:space:]]|workflow[[:space:]]+(run|enable|disable)|api[[:space:]][^;&|]*([[:space:]]-x[[:space:]]|[[:space:]]-x[^[:space:]]|--method)|api[[:space:]][^;&|]*[[:space:]](-f|-F|--field|--raw-field|--input)[[:space:]=]|api[[:space:]][^;&|]*[[:space:]]-f[^[:space:]=])" \
    && deny "gh writes (comments, labels, pull requests, releases, repository changes, non-GET api calls) are never run during $run_kind; $tracker_why"
  printf '%s' "$lc" | grep -Eq "${B}glab(\\.exe)?[[:space:]][^;&|]*\\b(issue[[:space:]]+(note|update|close|reopen|create|delete|subscribe|unsubscribe)|mr[[:space:]]|label[[:space:]]|release[[:space:]]|repo[[:space:]]+(create|delete|archive|fork|mirror)|variable[[:space:]]|ci[[:space:]]+(run|retry|delete|trigger)|api[[:space:]][^;&|]*([[:space:]]-x[[:space:]]|[[:space:]]-x[^[:space:]]|--method)|api[[:space:]][^;&|]*[[:space:]](-f|-F|--field|--raw-field|--input)[[:space:]=]|api[[:space:]][^;&|]*[[:space:]]-f[^[:space:]=])" \
    && deny "glab writes (notes, labels, merge requests, releases, repository changes, non-GET api calls) are never run during $run_kind; $tracker_why"
  # The token itself is never read out: it is the only thing that makes a tracker write count.
  printf '%s' "$lc" | grep -Eq "${B}(gh|glab)(\\.exe)?[[:space:]]+auth[[:space:]]+(token|status[^;&|]*(-t\\b|--show-token))" \
    && deny "reading the tracker token is never allowed during $run_kind"
fi

if [ "$PROFILE" = "autopilot" ]; then
  # A program word built at run time (a substitution, a backtick, eval) is the way around every
  # name rule above; the stage spells its commands out.
  # One pass over the segments (a loop here costs a process per `;`, `&` or `|`, so a long command
  # could outlast the hook's timeout): a segment starts, after its leading NAME=value words, with
  # a substitution, a backtick, nohup ... $( or eval.
  seg_pre='^[[:space:]]*([a-z_][a-z0-9_]*=[^[:space:]]*[[:space:]]+)*'
  segs="$(printf '%s\n' "$lc" | tr ';&|' '\n')"
  printf '%s\n' "$segs" | grep -Eq "${seg_pre}"'(\$\(|"\$\(|'"'"'\$\(|`|"`|nohup[[:space:]].*\$\()' \
    && deny "a command whose program is built by substitution cannot be verified during an autopilot stage; spell the command out"
  printf '%s\n' "$segs" | grep -Eq "${seg_pre}"'eval([[:space:]]|$)' \
    && deny "eval is never run by an autopilot stage; its command cannot be verified"
fi

# Forbidden hosts anywhere in the command line.
IFS=',' read -r -a forbidden_hosts <<< "$forbidden"
for h in "${forbidden_hosts[@]:-}"; do
  [ -n "$h" ] && printf '%s' "$lc" | grep -qF -- "$h" && deny "forbidden host '$h' appears in the command"
done

# No stack teardown: docker[- ]compose down|stop|rm; docker rm|kill|stop; the container,
# volume, network and image sub-noun forms; any docker ... prune.
# The compose rules match the SUBCOMMAND: compose's global options (with or without a value:
# `-f a.yml`, `--profile p`, `--verbose`) are skipped and the next word is the subcommand, so
# `docker compose run --rm api` and `docker compose exec api npm start` are not a teardown or a start.
COMPOSE_SUB='docker[-[:space:]]compose([[:space:]]+-[a-z-]+([[:space:]=][^[:space:]]+)?)*[[:space:]]+'
printf '%s' "$lc" | grep -Eq "${COMPOSE_SUB}(down|stop|rm)\\b"'|docker[[:space:]]+(rm|kill|stop)\b|docker[[:space:]]+(container|volume|network|image)[[:space:]]+(rm|stop|prune)\b|docker[^;&|]*\bprune\b' \
  && deny "container stop, remove, down or prune is never allowed; the stack stays as found"
# Nor a restart, start, rebuild or pause: the run observes the stack, it does not change it.
printf '%s' "$lc" | grep -Eq "${COMPOSE_SUB}(up|build|restart|start|kill|pause|unpause|create)\\b"'|docker[[:space:]]+(restart|start|pause|unpause|update)\b|docker[[:space:]]+container[[:space:]]+(restart|start|kill|pause)\b' \
  && deny "restarting, starting, rebuilding or pausing containers is never allowed; the stack stays as found"
# Killing processes by name reaches the app under test; a targeted kill <pid> of the run's
# own background suite stays allowed.
printf '%s' "$lc" | grep -Eq "${B}(pkill|killall|taskkill)([[:space:]]|\$)|stop-process([[:space:]]|\$)" \
  && deny "killing processes by name is blocked; the stack stays as found"

# Database read-only. The SQL itself (statement starts, functions, meta-commands, the user a
# connection string names) is judged by the write analyzer below, which tokenizes the command and
# follows `sh -c` and `docker exec`; what stays here is what only a text match can see: a
# substitution inside the command and a comment that could hide a verb.
if printf '%s' "$lc" | grep -Eq '\bpsql\b'; then
  printf '%s' "$cmd" | grep -Eq '\$\(|`' \
    && deny "command substitution inside a psql command is blocked; the SQL must be literal and inspectable"
  printf '%s' "$cmd" | grep -Eq '/\*|\*/|--[[:space:]]|--$' \
    && deny "SQL comments inside inline psql are blocked; they only serve to hide a write verb"
fi

# Destructive filesystem: short and long rm options, find -delete, disk tools, device writes. No
# exception: the run's own marker is removed by the human partner, never by a call of the run (the
# write analyzer below reads the same rules on the words the shell runs, however they are quoted).
printf '%s' "$lc" | grep -Eq "${B}rm[[:space:]]+-[a-z]*[rf]|${B}rm[[:space:]]+--(recursive|force|dir)|${B}(rmdir|shred|mkfs|dd)[[:space:]]|>[[:space:]]*/dev/(sd|nvme)|${B}find[[:space:]][^;&|]*[[:space:]]-delete\\b|${B}(rd|rmdir)[[:space:]]+/s|${B}del[[:space:]][^;&|]*/[sfq]\\b|remove-item[^;&|]*[[:space:]]-(recurse|force)" \
  && deny "recursive or forced delete is blocked"
# PowerShell file cmdlets write, move or delete files; the file tools are gated to
# reviews/<id>/ and .ultrapowers/, these are not.
printf '%s' "$lc" | grep -Eq '(^|[^a-z-])(set-content|add-content|out-file|new-item|copy-item|move-item|remove-item|rename-item|clear-content|set-item)([^a-z-]|$)' \
  && deny "PowerShell file cmdlets are blocked during $run_kind; write files with the file tools"

# Git working-tree destruction.
printf '%s' "$lc" | grep -Eq '\bgit\b[^;&|]*\b(reset[[:space:]]+--hard|clean[[:space:]]+-[a-z]*f|checkout[[:space:]]+--[[:space:]]|restore[[:space:]]|stash[[:space:]]+drop|branch[[:space:]]+-d)' \
  && deny "git commands that discard work (reset --hard, clean -f, checkout --, restore, stash drop, branch -D) are blocked"

# Permission and ownership changes.
printf '%s' "$lc" | grep -Eq "${B}(chmod|chown|chgrp|icacls|takeown)[[:space:]]" \
  && deny "permission or ownership change is blocked"

# Remote shells and copies; inline interpreters; raw network redirection.
remote_re="${B}(ssh|scp|sftp|rsync|telnet|nc|ncat|netcat|socat|ftp|tftp|lftp)(\\.exe)?[[:space:]]|${B}openssl(\\.exe)?[[:space:]]+s_(client|server)\\b"
if printf '%s' "$lc" | grep -Eq "$remote_re"; then
  if [ "$PROFILE" = "hunt" ]; then
    remote_hit="$(printf '%s' "$lc" | grep -Eo "$remote_re" | head -n 1)"
    remote_hit="${remote_hit//[^a-z0-9]/}"; remote_hit="${remote_hit%exe}"
    deny "the hunt's network is its audit tools and gh api; ${remote_hit:-a remote shell or copy} is refused"
  fi
  deny "remote shell or copy is blocked"
fi
printf '%s' "$lc" | grep -Eq "${B}(python3?|node|nodejs|perl|ruby|php|deno|bun)(\\.exe)?[[:space:]]+(-c|-e|-p|--print|--eval|-)([[:space:]]|\$)" \
  && deny "inline interpreter code is blocked; it is an unbounded egress and execution bypass"
# Empty quote pairs inside a word change nothing for the shell (/dev/t""cp, envi''ron): the rules below that name
# a path read the command without them.
dq='"'; sq="'"
lc_nq="${lc//$dq$dq/}"; lc_nq="${lc_nq//$sq$sq/}"
printf '%s' "$lc_nq" | grep -Eq '/dev/(tcp|udp)/' \
  && deny "/dev/tcp and /dev/udp network redirection is blocked"

# Key material named anywhere in a command, whatever reads or sends it; environment dumps;
# uploads. `.env.example` is the documented template and stays readable.
key_lc="${lc//.env.example/}"
# The canonical spelling: `~/.config//gh` and `~/.config/./gh` open the same file as `~/.config/gh`.
while [[ "$key_lc" == *//* ]]; do key_lc="${key_lc//\/\//\/}"; done
while [[ "$key_lc" == */./* ]]; do key_lc="${key_lc//\/.\//\/}"; done
printf '%s' "$key_lc" | grep -Eq '(^|/)\.ssh([^a-z0-9_.-]|$)|authorized_keys|id_rsa|id_ed25519|id_ecdsa|\.aws/credentials|\.gem/credentials|mcp-secrets\.env|secrets\.local|\.local\.sh|(^|[/[:space:]@"'"'"'=])\.env([^a-z0-9_]|$)|\.git-credentials|(^|[/[:space:]@"'"'"'=])\.(netrc|npmrc)([^a-z0-9_]|$)|\.config/(gh|glab-cli)(/|[^a-z0-9_.-]|$)|\.docker/config\.json|(^|[/[:space:]@"'"'"'=])\.(kube|gnupg)(/|[^a-z0-9_.-]|$)|(^|[/[:space:]@"'"'"'=])\.(pypirc|pgpass|vault-token)([^a-z0-9_]|$)|\.cargo/credentials|\.config/gcloud(/|[^a-z0-9_.-]|$)|(^|[/[:space:]@"'"'"'=])\.azure(/|[^a-z0-9_.-]|$)' \
  && deny "reading or transferring key material is blocked"
printf '%s' "$lc" | grep -Eq "${B}(printenv|env)[[:space:]]*(\$|[;&|])" \
  && deny "dumping the environment is blocked; check a variable with \${NAME:+set} instead"
# The process environment is also a file: /proc/<pid>/environ holds every variable.
printf '%s' "$lc_nq" | grep -Eq '/proc/[^[:space:];&|]*environ' \
  && deny "reading a process environment (/proc/<pid>/environ) is blocked; check a variable with \${NAME:+set} instead"
# (-t is curl's -T upload only: wget's -T is its timeout and -t its retry count.)
{ printf '%s' "$lc" | grep -Eq '(curl|wget)[^;&|]*(--upload-file|--data-binary[[:space:]]*@|-d[[:space:]]*@|-f[[:space:]][^;&|]*@)' \
  || printf '%s' "$lc" | grep -Eq 'curl[^;&|]*-t '; } \
  && deny "outbound file upload is blocked"

# Egress allow-list (active when qa.hosts.allowed is set): curl/wget reach only listed hosts,
# and only through literal URLs; a $VAR target fails closed. The host ends at a shell word
# terminator (`;`, `&`, `|`, `(`, `)`, `<`, `>`), but a `$` or backtick stays in it: a variable
# right after the authority can append `@other-host` and change the target.
# Shell writes (spec 3.5): redirects, tee, curl -o, cp/mv/install/ln destinations, rm
# operands, in-place editors and git subcommands, checked by the quote-aware analyzer. Its
# inputs travel on stdin so Git Bash's argument conversion cannot rewrite the paths.
writes_js="$hook_dir_node/lib/qa-shell-writes.mjs"
# Lane 4's psql rules live in the analyzer too: it walks xargs, find -exec, eval, sudo, su -c,
# kubectl exec and brace groups, refuses a program built from a variable, and refuses a psql
# word it did not inspect (fail closed on its own count), so no text check is repeated here.
wreason="$(printf '%s\0%s\0%s\0%s\0%s\0%s\0%s' "$base_cwd" "$root" "$ticket" "$ignore_case" "$role_vars" "$ro_role" "$cmd" | ULTRAPOWERS_GUARD_PROFILE="$PROFILE" ULTRAPOWERS_GUARD_HOSTS="$allowed" node "$writes_js" 2>&1)" \
  || wreason="the command could not be analysed for writes; it is refused during $run_kind"
[ -z "$wreason" ] || deny "$wreason"

# Egress shape, whatever the allow-list says. A substitution inside a URL (`$(`, a backtick, `${`) is
# the exfiltration shape: the data rides in the query or the path, and no host list can see it. An
# upload or data flag (-d, --data*, -F, --form, -T, --upload-file, -X POST|PUT|PATCH|DELETE, wget
# --post-data|--post-file|--body-data|--body-file, iwr -Body|-InFile|-Form) sends bytes out: its host
# must be in qa.hosts.allowed (an empty list names no host). Plain GETs to other hosts stay as before.
# The hunt runs none of these programs (the analyzer above refuses each by name), so the word curl in a
# search (git grep curl) is no call and the text rules of this section do not apply to it.
NET_RE="${B}(curl|wget)(\\.exe)?[[:space:]]|invoke-webrequest|invoke-restmethod|${B}(iwr|irm)[[:space:]]"
if [ "$PROFILE" != "hunt" ] && printf '%s' "$lc" | grep -Eq "$NET_RE"; then
  printf '%s' "$cmd" | grep -Eq '://[^[:space:]]*(\$\(|`|\$\{)' \
    && deny "a command or variable substitution inside a URL can carry data out in the URL and is blocked; use a literal URL"
  # curl reads more options (a URL, data, a header) from a --config file, which cannot be inspected.
  printf '%s' "$lc" | grep -Eq "${B}curl(\\.exe)?[[:space:]]" \
    && printf '%s' "$cmd" | grep -Eq '(^|[[:space:]])(-[A-Za-z0-9]*K|--config)([[:space:]=]|$)' \
    && deny "curl --config (-K) reads its options from a file that cannot be inspected; give the options on the command line"
  # wget reads its URLs from a file or stdin with -i / --input-file: the host check never sees them.
  printf '%s' "$lc" | grep -Eq "${B}wget(\\.exe)?[[:space:]]" \
    && printf '%s' "$cmd" | grep -Eq '(^|[[:space:]])(-[A-Za-z0-9]*i|--input-file)([[:space:]=]|$)' \
    && deny "wget --input-file (-i) reads its URLs from a file that cannot be inspected; give the URL on the command line"
  sends=0
  printf '%s' "$lc" | grep -Eq "${B}curl(\\.exe)?[[:space:]]" \
    && printf '%s' "$cmd" | grep -Eq '(^|[[:space:]])-[A-Za-z0-9]*[dFT]|(^|[[:space:]])--(data[a-z-]*|form[a-z-]*|upload-file|json)([[:space:]=]|$)' && sends=1
  printf '%s' "$lc" | grep -Eq '(^|[[:space:]])(-[a-z0-9]*x|--request|--method|-method)[[:space:]=]*(post|put|patch|delete)|(^|[[:space:]])--(post-data|post-file|body-data|body-file)([[:space:]=]|$)|(^|[[:space:]])-(body|infile|form)([[:space:]]|$)' && sends=1
  if [ "$sends" -eq 1 ]; then
    surls="$(printf '%s' "$cmd" | grep -Eoi 'https?://[^/"'"'"'[:space:];&|()<>]+' || true)"
    [ -n "$surls" ] || deny "an upload or data flag without a literal http(s) URL; the destination cannot be verified"
    while IFS= read -r u; do
      [ -n "$u" ] || continue
      host_of_r "$u"; h="$REPLY"
      on_list "$allowed" "$h" || deny "an upload or data flag to host '$h', which is not in qa.hosts.allowed, is blocked"
    done <<< "$surls"
  fi
fi

# The ticket tracker's hosts (tickets.sources[].url, .mcpUrl), autopilot profile: a shell call
# to the tracker is an engine step (a label, a note, a packet), never a stage's. This holds
# whether or not qa.hosts.allowed lists the host.
if [ "$PROFILE" = "autopilot" ] && [ -n "$tracker_hosts" ] \
  && printf '%s' "$lc" | grep -Eq "${B}(curl|wget)(\\.exe)?[[:space:]]|invoke-webrequest|invoke-restmethod|${B}(iwr|irm)[[:space:]]"; then
  turls="$(printf '%s' "$cmd" | grep -Eoi 'https?://[^/"'"'"'[:space:];&|()<>]+' || true)"
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    host_of_r "$u"; h="$REPLY"
    on_list "$tracker_hosts" "$h" && deny "calls to the ticket tracker ($h) are engine steps; a stage reads the ticket through its tracker tools and never writes it from the shell"
  done <<< "$turls"
fi

if [ "$PROFILE" != "hunt" ] && [ -n "$allowed" ] && printf '%s' "$lc" | grep -Eq "${B}(curl|wget)(\\.exe)?[[:space:]]|invoke-webrequest|invoke-restmethod|${B}(iwr|irm)[[:space:]]"; then
  urls="$(printf '%s' "$cmd" | grep -Eoi 'https?://[^/"'"'"'[:space:];&|()<>]+' || true)"
  [ -n "$urls" ] || deny "curl/wget without a literal http(s) URL; the target cannot be verified"
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    case "$u" in
      *'$'*|*'`'*) deny "the URL's host part is built from a variable or command substitution ($u); use a literal URL" ;;
    esac
    host_of_r "$u"; h="$REPLY"
    on_list "$allowed" "$h" || deny "host '$h' is not in qa.hosts.allowed"
  done <<< "$urls"
fi

exit 0
