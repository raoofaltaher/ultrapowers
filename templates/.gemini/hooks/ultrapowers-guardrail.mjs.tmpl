#!/usr/bin/env node
// Written by ultrapowers init. Gemini CLI runs this as the project's BeforeTool hook
// (.gemini/settings.json): it hands the tool event to the ultrapowers guardrail of the installed
// extension, so a QA run or an autopilot stage has the same envelope here as on the other
// harnesses. Inert without a run marker. Set ULTRAPOWERS_PLUGIN_ROOT when the extension lives
// somewhere other than ~/.gemini/extensions/ultrapowers.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const roots = [process.env.ULTRAPOWERS_PLUGIN_ROOT, path.join(os.homedir(), '.gemini', 'extensions', 'ultrapowers')].filter(Boolean);
const cli = roots.map((r) => path.join(r, 'hooks', 'lib', 'guardrail-cli.mjs')).find((f) => fs.existsSync(f));

let input = '';
try {
  input = fs.readFileSync(0, 'utf8');
} catch {
  input = '';
}

// The run marker at or above start (the QA profile wins): its deny prefix and path, or null.
// With ULTRAPOWERS_AUTOPILOT_INSIDE=1 (a headless stage) and no marker, the run is an autopilot
// stage all the same (marker null), as in the hook.
function runActive(start) {
  let dir = path.resolve(start || process.cwd());
  for (;;) {
    const qa = path.join(dir, '.ultrapowers', 'qa-active');
    if (fs.existsSync(qa)) return { prefix: 'QA-GUARDRAIL', marker: qa };
    const autopilot = path.join(dir, '.ultrapowers', 'autopilot-active');
    if (fs.existsSync(autopilot)) return { prefix: 'AUTOPILOT-GUARDRAIL', marker: autopilot };
    const parent = path.dirname(dir);
    if (parent === dir) return process.env.ULTRAPOWERS_AUTOPILOT_INSIDE === '1' ? { prefix: 'AUTOPILOT-GUARDRAIL', marker: null } : null;
    dir = parent;
  }
}

if (!cli) {
  // Every candidate is searched: the event's cwd, the process cwd and the call's own dir_path; a
  // tool argument can add a run, never hide one.
  const candidates = [process.cwd()];
  try {
    const ev = JSON.parse(input);
    if (typeof ev.cwd === 'string' && ev.cwd) candidates.unshift(ev.cwd);
    const dirPath = ev.tool_input && ev.tool_input.dir_path;
    if (typeof dirPath === 'string' && dirPath) candidates.push(path.resolve(candidates[0], dirPath));
  } catch {
    // an unreadable event is judged by the process cwd
  }
  const active = candidates.map((c) => runActive(c)).find(Boolean);
  if (active) {
    process.stderr.write(`${active.prefix} DENY: the ultrapowers extension was not found, and ${active.marker ?? 'ULTRAPOWERS_AUTOPILOT_INSIDE=1'} marks a run; a tool call during a run is refused without its guardrail\n`);
    process.exit(2);
  }
  process.exit(0);
}

const res = spawnSync(process.execPath, [cli], { input, encoding: 'utf8', stdio: ['pipe', 'inherit', 'inherit'] });
process.exit(res.status ?? 2);
