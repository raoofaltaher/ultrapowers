#!/bin/sh
GITLEAKS="$(command -v gitleaks 2>/dev/null)"
if [ -z "$GITLEAKS" ] && [ -n "$LOCALAPPDATA" ]; then
  for candidate in "$LOCALAPPDATA"/Microsoft/WinGet/Links/gitleaks.exe \
                   "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    if [ -x "$candidate" ]; then GITLEAKS="$candidate"; break; fi
  done
fi
if [ -n "$GITLEAKS" ] && ! "$GITLEAKS" version >/dev/null 2>&1; then
  echo "warning: $GITLEAKS is present but cannot execute (Application Control?); trying Docker." >&2
  GITLEAKS=""
fi
# Use the project's rules when .gitleaks.toml exists, gitleaks' defaults otherwise.
set --
if [ -f .gitleaks.toml ]; then set -- --config .gitleaks.toml; fi
if [ -n "$GITLEAKS" ]; then
  "$GITLEAKS" git --pre-commit --staged --no-banner "$@" || {
    echo "gitleaks: potential secret in staged changes - commit blocked." >&2
    exit 1
  }
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  # The image is pinned to a release tag and to its multi-arch index digest (supply chain): update
  # tag and digest together, on purpose, after reading the gitleaks release notes, never by pulling
  # :latest. The scan needs no network, so the container gets none.
  docker_status=0
  MSYS_NO_PATHCONV=1 docker run --rm --network none -v "$(pwd):/repo:ro" -w /repo \
    zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f \
    git --pre-commit --staged --no-banner "$@" || docker_status=$?
  if [ "$docker_status" -eq 1 ]; then
    echo "gitleaks (docker): potential secret in staged changes - commit blocked." >&2
    exit 1
  elif [ "$docker_status" -ne 0 ]; then
    # 125 (daemon or pull error), 126 and 127 are docker failures, not findings.
    echo "gitleaks (docker) could not run (exit $docker_status); secret scan skipped." >&2
  fi
else
  echo "warning: gitleaks unavailable (no working binary, no docker); secret scan skipped." >&2
fi
# >>> team-memory lint
# Runs the ultrapowers memory lint when this commit stages changes under the
# team-memory store and the plugin checkout is reachable (ULTRAPOWERS_ROOT, or
# the Claude Code plugin cache). Findings block the commit; an unreachable
# plugin warns and continues.
if [ -f ".agents/memory/MEMORY.md" ] && command -v node >/dev/null 2>&1 \
  && git diff --cached --name-only | grep -q '^\.agents/memory/'; then
  memory_lint=""
  for candidate in \
    "${ULTRAPOWERS_ROOT:-/nonexistent}/skills/team-memory/scripts/memory-lint.mjs" \
    "${HOME}"/.claude/plugins/cache/*/ultrapowers/*/skills/team-memory/scripts/memory-lint.mjs \
    "${HOME}"/.claude/plugins/marketplaces/ultrapowers/skills/team-memory/scripts/memory-lint.mjs; do
    if [ -f "$candidate" ]; then
      memory_lint="$candidate"
      break
    fi
  done
  if [ -n "$memory_lint" ]; then
    # Lint the staged snapshot, not the working tree: an untracked draft must
    # not block a clean commit, and a fix left unstaged must not hide a broken one.
    snapshot="$(mktemp -d 2>/dev/null)" || snapshot=""
    lint_dir=".agents/memory"
    if [ -n "$snapshot" ] && git ls-files -z -- .agents/memory .agents/ultrapowers.json \
        | xargs -0 git checkout-index --prefix="$snapshot/" -- 2>/dev/null; then
      lint_dir="$snapshot/.agents/memory"
    fi
    lint_status=0
    node "$memory_lint" "$lint_dir" || lint_status=$?
    if [ -n "$snapshot" ]; then rm -rf "$snapshot"; fi
    if [ "$lint_status" -ne 0 ]; then
      echo "pre-commit: team-memory lint found problems (listed above). Fix them, or run 'team-memory lint' with your agent." >&2
      exit 1
    fi
  else
    echo "pre-commit: team-memory lint skipped (ultrapowers plugin not found; set ULTRAPOWERS_ROOT to its checkout)" >&2
  fi
elif [ -f ".agents/memory/MEMORY.md" ] && ! command -v node >/dev/null 2>&1 \
  && git diff --cached --name-only | grep -q '^\.agents/memory/'; then
  echo "pre-commit: team-memory lint skipped (node not found)" >&2
fi
# <<< team-memory lint
# >>> spec check
# Runs the ultrapowers spec check on the specs this commit stages: every spec it
# adds, and every spec it changes or renames that already carries a "## Decision
# record", so an old spec edited or moved for another reason is not held to the
# template (a rename is a modification, not a new file). The project's own
# template, specs/_template/Spec.md, is never checked itself. Paths are listed
# with core.quotePath off, so a name with non-ASCII characters matches the filter.
# Findings block the commit; an unreachable plugin or a missing node warns and
# continues.
spec_pattern='^(specs/[^/]+/Spec\.md|docs/ultrapowers/specs/[^/]+-design\.md)$'
spec_files="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=A | grep -E "$spec_pattern" | grep -v '^specs/_template/Spec\.md$')
$(git -c core.quotePath=false diff --cached --name-only --diff-filter=MR | grep -E "$spec_pattern" | grep -v '^specs/_template/Spec\.md$' | while IFS= read -r f; do
  git show ":$f" | grep -q '^## Decision record' && printf '%s\n' "$f"; done)"
spec_files="$(printf '%s\n' "$spec_files" | grep .)"
if [ -n "$spec_files" ] && command -v node >/dev/null 2>&1; then
  spec_check=""
  for candidate in \
    "${ULTRAPOWERS_ROOT:-/nonexistent}/skills/brainstorming/scripts/check-doc.mjs" \
    "${HOME}"/.claude/plugins/cache/*/ultrapowers/*/skills/brainstorming/scripts/check-doc.mjs \
    "${HOME}"/.claude/plugins/marketplaces/ultrapowers/skills/brainstorming/scripts/check-doc.mjs; do
    if [ -f "$candidate" ]; then
      spec_check="$candidate"
      break
    fi
  done
  if [ -n "$spec_check" ]; then
    # Check the staged snapshot, not the working tree, as the memory lint does.
    # It also holds the staged template and config (the ones that are tracked), so
    # the checker reads the template this commit will contain.
    spec_snapshot="$(mktemp -d 2>/dev/null)" || spec_snapshot=""
    spec_root="."
    if [ -n "$spec_snapshot" ]; then
      if printf '%s\n' "$spec_files" specs/_template/Spec.md .agents/ultrapowers.json \
          | tr '\n' '\0' \
          | xargs -0 git ls-files -z -- \
          | xargs -0 git checkout-index --prefix="$spec_snapshot/" -- 2>/dev/null; then
        spec_root="$spec_snapshot"
      fi
    fi
    spec_status=0
    while IFS= read -r f; do
      node "$spec_check" "$spec_root/$f" </dev/null || spec_status=1
    done <<SPEC_FILES
$spec_files
SPEC_FILES
    if [ -n "$spec_snapshot" ]; then rm -rf "$spec_snapshot"; fi
    if [ "$spec_status" -ne 0 ]; then
      echo "pre-commit: spec check found problems (listed above). Fix them, or run the spec check with your agent." >&2
      exit 1
    fi
  else
    echo "pre-commit: spec check skipped (ultrapowers plugin not found; set ULTRAPOWERS_ROOT to its checkout)" >&2
  fi
elif [ -n "$spec_files" ] && ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: spec check skipped (node not found)" >&2
fi
# <<< spec check
